<view class="card" bindtap="onTap">
  <view class="cover-wrap" style="padding-bottom: {{ratio * 100}}%;">
    <swiper
      wx:if="{{imageList.length > 1}}"
      class="cover-swiper"
      current="{{currentImage}}"
      bindchange="onImageChange"
      circular="{{false}}"
    >
      <swiper-item wx:for="{{imageList}}" wx:key="*this">
        <view class="cover-stage">
          <image class="cover-bg" src="{{item}}" mode="aspectFill" lazy-load="true" />
          <image class="cover" src="{{item}}" mode="aspectFit" lazy-load="true" bindload="onCoverLoad" data-index="{{index}}" />
        </view>
      </swiper-item>
    </swiper>
    <view wx:elif="{{imageList.length}}" class="cover-stage">
      <image class="cover-bg" src="{{imageList[0]}}" mode="aspectFill" lazy-load="true" />
      <image class="cover" src="{{imageList[0]}}" mode="aspectFit" lazy-load="true" bindload="onCoverLoad" data-index="0" />
    </view>
    <view wx:if="{{imageList.length > 1}}" class="image-count">{{currentImage + 1}}/{{imageList.length}}</view>
    <view wx:if="{{note.video}}" class="video-tag">▶</view>
    <view wx:if="{{deletable}}" class="card-del" catchtap="onDelete">×</view>
  </view>
  <view class="info">
    <view class="title ellipsis-2">{{note.title}}</view>
    <view class="bottom">
      <image class="avatar" src="{{note.author.avatar}}" mode="aspectFill" />
      <text class="name ellipsis">{{note.author.name}}</text>
      <view class="like" catchtap="onLike">
        <view class="heart {{note.liked ? 'active' : ''}}"></view>
        <text class="count">{{likeText}}</text>
      </view>
    </view>
  </view>
</view>
