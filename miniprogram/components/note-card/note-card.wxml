<view class="card" bindtap="onTap">
  <view class="cover-wrap" style="padding-bottom: {{ratio * 100}}%;">
    <view wx:if="{{imageList.length}}" class="cover-stage">
      <image class="cover-bg" src="{{imageList[0]}}" mode="aspectFill" lazy-load="true" />
      <image class="cover" src="{{imageList[0]}}" mode="aspectFit" lazy-load="true" bindload="onCoverLoad" data-index="0" />
    </view>
    <view wx:if="{{note.video}}" class="video-tag">▶</view>
    <view wx:if="{{deletable}}" class="card-del" catchtap="onDelete">×</view>
  </view>
  <view class="info">
    <view class="title ellipsis-2">{{note.title}}</view>
    <view class="bottom">
      <image class="avatar" src="{{note.author.avatar}}" mode="aspectFill" />
      <view class="name ellipsis">{{note.author.name}}</view>
      <view class="like" catchtap="onLike">
        <view class="heart {{note.liked ? 'active' : ''}}"></view>
        <view class="count">{{likeText}}</view>
      </view>
    </view>
  </view>
</view>
