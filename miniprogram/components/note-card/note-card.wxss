.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.cover-wrap {
  position: relative;
  width: 100%;
  height: 0;
  background: #f0f0f0;
}
.cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.video-tag {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  color: #fff;
  font-size: 22rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.5);
}

.info {
  padding: 16rpx;
}
.title {
  font-size: 27rpx;
  line-height: 1.4;
  color: #333;
  margin-bottom: 14rpx;
}
.bottom {
  width: 100%;
}
.author {
  flex: 1;
  min-width: 0;
}
.avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.name {
  font-size: 23rpx;
  color: #999;
  max-width: 140rpx;
}
.like {
  flex-shrink: 0;
}
.heart {
  font-size: 28rpx;
  margin-right: 6rpx;
}
.heart.active {
  animation: pop .3s ease;
}
.count {
  font-size: 23rpx;
  color: #999;
}
@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}
