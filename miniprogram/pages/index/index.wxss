.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 头部 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}
.nav {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.search-bar {
  flex: 1;
  height: 64rpx;
  background: #f3f3f3;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-ph {
  color: #999;
  font-size: 26rpx;
}

.tabs {
  white-space: nowrap;
  padding: 8rpx 16rpx 12rpx;
}
.tab {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active {
  color: #333;
  font-weight: 600;
  font-size: 32rpx;
}

/* 内容 */
.content {
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
.loadmore {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 30rpx 0 50rpx;
}
