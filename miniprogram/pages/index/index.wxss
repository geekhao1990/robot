.page {
  height: 100vh;
  background: #f5f5f5;
  overflow: hidden;
}

/* 头部 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}
.nav {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.nav-tabs {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-tab {
  position: relative;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #999;
  line-height: 1;
}
.nav-tab.active {
  color: #333;
  font-weight: 700;
  font-size: 34rpx;
}
.nav-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -14rpx;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  background: #ff2442;
  border-radius: 999rpx;
}
.search-row {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.search-box {
  width: 100%;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 999rpx;
}
.search-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  margin-right: 14rpx;
  border: 3rpx solid #999;
  border-radius: 50%;
  box-sizing: border-box;
}
.search-icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  width: 9rpx;
  height: 3rpx;
  background: #999;
  border-radius: 999rpx;
  transform: rotate(45deg);
  transform-origin: left center;
}
.search-placeholder {
  color: #999;
  font-size: 27rpx;
}

/* 内容 */
.feed-scroll {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
}
.refresh-indicator {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #999;
  font-size: 24rpx;
}
.refresh-arrow {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c8c8c8;
  border-radius: 50%;
  color: #888;
  font-size: 28rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 160ms ease;
  box-sizing: border-box;
}
.refresh-arrow.is-ready {
  color: #ff2442;
  border-color: #ff2442;
  transform: rotate(180deg);
}
.refresh-loading {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #dedede;
  border-top-color: #ff2442;
  border-radius: 50%;
  box-sizing: border-box;
  animation: refresh-spin 700ms linear infinite;
}
@keyframes refresh-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.content {
  min-height: 100%;
  padding-left: 12rpx;
  padding-right: 12rpx;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
.loadmore {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 30rpx 0 50rpx;
}
