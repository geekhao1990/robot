<view class="page">
  <!-- 自定义头部 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav" style="height: {{navBarHeight}}px;">
      <view class="nav-tabs">
        <view
          wx:for="{{navTabs}}"
          wx:key="key"
          class="nav-tab {{item.key === tab ? 'active' : ''}}"
          data-tab="{{item.key}}"
          bindtap="onTabChange"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="search-row" style="height: {{searchBarHeight}}px;" bindtap="goSearch">
      <view class="search-box">
        <view class="search-icon"></view>
        <text class="search-placeholder">搜索资料、课程</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="content" style="padding-top: {{headerHeight}}px;">
    <view wx:if="{{loading && !left.length && !right.length}}" class="placeholder">加载中...</view>

    <view wx:elif="{{!left.length && !right.length}}" class="placeholder">{{emptyText}}</view>

    <view wx:else class="waterfall">
      <view class="column">
        <note-card
          wx:for="{{left}}"
          wx:key="id"
          note="{{item}}"
          bindtap="goDetail"
          bindlike="onCardLike"
        />
      </view>
      <view class="column">
        <note-card
          wx:for="{{right}}"
          wx:key="id"
          note="{{item}}"
          bindtap="goDetail"
          bindlike="onCardLike"
        />
      </view>
    </view>

    <view wx:if="{{!loading && (left.length || right.length)}}" class="loadmore">
      {{hasMore ? '上拉加载更多' : '没有更多了～'}}
    </view>
  </view>
</view>
