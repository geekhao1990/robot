<view class="page">
  <!-- 自定义头部 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav" style="height: {{navBarHeight}}px;">
      <view class="search-bar" bindtap="goSearch">
        <text class="search-icon">🔍</text>
        <text class="search-ph">搜索你感兴趣的内容</text>
      </view>
    </view>
    <!-- 分类标签 -->
    <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="tab {{item === category ? 'active' : ''}}"
        data-cat="{{item}}"
        bindtap="onTabChange"
      >{{item}}</view>
    </scroll-view>
  </view>

  <!-- 内容区 -->
  <view class="content" style="padding-top: {{headerHeight}}px;">
    <view wx:if="{{loading && !left.length && !right.length}}" class="placeholder">加载中...</view>

    <view wx:elif="{{!left.length && !right.length}}" class="placeholder">这里还没有内容～</view>

    <view wx:else class="waterfall">
      <view class="column">
        <note-card
          wx:for="{{left}}"
          wx:key="id"
          note="{{item}}"
          bindtap="goDetail"
          bindlike="onCardLike"
        />
      </view>
      <view class="column">
        <note-card
          wx:for="{{right}}"
          wx:key="id"
          note="{{item}}"
          bindtap="goDetail"
          bindlike="onCardLike"
        />
      </view>
    </view>

    <view wx:if="{{!loading && (left.length || right.length)}}" class="loadmore">
      {{hasMore ? '上拉加载更多' : '没有更多了～'}}
    </view>
  </view>
</view>
