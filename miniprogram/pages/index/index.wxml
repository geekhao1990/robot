<view class="page">
  <!-- 自定义头部 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav" style="height: {{navBarHeight}}px;">
      <view class="nav-tabs">
        <view
          wx:for="{{navTabs}}"
          wx:key="key"
          class="nav-tab {{item.key === tab ? 'active' : ''}}"
          data-tab="{{item.key}}"
          bindtap="onTabChange"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="search-row" style="height: {{searchBarHeight}}px;" bindtap="goSearch">
      <view class="search-box">
        <view class="search-icon"></view>
        <text class="search-placeholder">搜索</text>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <scroll-view
    class="feed-scroll"
    style="top: {{headerHeight}}px;"
    scroll-y
    enhanced
    lower-threshold="120"
    refresher-enabled
    refresher-threshold="64"
    refresher-default-style="none"
    refresher-background="#f5f5f5"
    refresher-triggered="{{refreshing}}"
    bindscrolltolower="onScrollToLower"
    bindrefresherpulling="onRefresherPulling"
    bindrefresherrefresh="onRefresherRefresh"
    bindrefresherrestore="onRefresherRestore"
    bindrefresherabort="onRefresherAbort"
  >
    <view slot="refresher" class="refresh-indicator">
      <view wx:if="{{refreshing}}" class="refresh-loading"></view>
      <view wx:else class="refresh-arrow {{refreshReady ? 'is-ready' : ''}}">↓</view>
      <text>{{refreshing ? '刷新中' : (refreshReady ? '松开刷新' : '下拉刷新')}}</text>
    </view>

    <view class="content">
      <view wx:if="{{loading && !left.length && !right.length}}" class="placeholder">加载中...</view>

      <view wx:elif="{{!left.length && !right.length}}" class="placeholder">{{emptyText}}</view>

      <view wx:else class="waterfall">
        <view class="column">
          <note-card
            wx:for="{{left}}"
            wx:key="id"
            note="{{item}}"
            bindtap="goDetail"
            bindlike="onCardLike"
          />
        </view>
        <view class="column">
          <note-card
            wx:for="{{right}}"
            wx:key="id"
            note="{{item}}"
            bindtap="goDetail"
            bindlike="onCardLike"
          />
        </view>
      </view>

      <view wx:if="{{!loading && (left.length || right.length)}}" class="loadmore">
        {{hasMore ? '上拉加载更多' : '没有更多了～'}}
      </view>
    </view>
  </scroll-view>
</view>
