<view class="page">
  <view class="balance-card">
    <view><view class="balance-label">可用积分</view><view class="balance-value">{{balance}}</view></view>
    <view class="cash"><text>≈ ¥{{cashValue}}</text><label>{{pointsPerYuan}}积分 = 1元</label></view>
  </view>

  <view class="form-card">
    <view class="section-title">提现申请</view>
    <view class="field">
      <view class="field-label">提现金额</view>
      <view class="amount-input"><text>¥</text><input type="digit" value="{{amountYuan}}" placeholder="最低{{minimumYuan}}元" bindinput="onAmountInput" /></view>
      <view class="field-tip">本次冻结 {{pointsNeeded}} 积分，拒绝后自动退回</view>
    </view>
    <view class="field"><view class="field-label">收款人姓名</view><input class="text-input" maxlength="30" placeholder="请输入真实姓名" data-field="realName" bindinput="onInput" /></view>
    <view class="field"><view class="field-label">收款微信号或手机号</view><input class="text-input" maxlength="60" placeholder="用于人工微信打款及联系" data-field="contact" bindinput="onInput" /></view>
    <view class="field"><view class="field-label">备注（选填）</view><input class="text-input" maxlength="200" placeholder="可填写收款说明" data-field="remark" bindinput="onInput" /></view>
    <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交人工审核</button>
    <view class="notice">申请提交后积分暂时冻结，后台人工审核并打款；审核拒绝时积分原路退回。</view>
  </view>

  <view class="history-card">
    <view class="section-title">提现记录</view>
    <view wx:if="{{list.length}}" class="history-list">
      <view class="history-item" wx:for="{{list}}" wx:key="id">
        <view class="history-main"><view class="history-money">¥{{item.amountText}}</view><view class="history-time">{{item.timeText}} · {{item.points}}积分</view><view wx:if="{{item.reviewNote}}" class="history-note">审核说明：{{item.reviewNote}}</view></view>
        <view class="status status-{{item.status}}">{{item.statusText}}</view>
      </view>
    </view>
    <view wx:else class="empty">暂无提现记录</view>
  </view>
</view>
