page { background: #f7f7f7; }
.page { display: flex; flex-direction: column; width: 100%; min-height: 100vh; padding: 28rpx 28rpx 70rpx; box-sizing: border-box; }
.balance-card { display: flex; align-items: flex-end; justify-content: space-between; width: 100%; padding: 36rpx; color: #fff; background: linear-gradient(135deg,#ff526b,#ff2442); border-radius: 26rpx; box-sizing: border-box; }
.balance-label { font-size: 24rpx; opacity: .82; }
.balance-value { margin-top: 8rpx; font-size: 64rpx; line-height: 1; font-weight: 800; }
.cash { display: flex; flex-direction: column; align-items: flex-end; }
.cash text { font-size: 28rpx; font-weight: 700; }
.cash label { margin-top: 8rpx; font-size: 20rpx; opacity: .76; }
.form-card,.history-card { display: flex; flex-direction: column; width: 100%; margin-top: 24rpx; padding: 30rpx; background: #fff; border-radius: 24rpx; box-sizing: border-box; }
.section-title { color: #222; font-size: 30rpx; font-weight: 750; }
.field { display: flex; flex-direction: column; width: 100%; margin-top: 27rpx; }
.field-label { margin-bottom: 12rpx; color: #555; font-size: 24rpx; }
.amount-input { display: flex; align-items: center; width: 100%; padding: 18rpx 20rpx; background: #f7f7f7; border-radius: 14rpx; box-sizing: border-box; }
.amount-input text { margin-right: 14rpx; color: #222; font-size: 38rpx; font-weight: 700; }
.amount-input input { flex: 1; min-width: 0; height: 54rpx; color: #222; font-size: 40rpx; }
.text-input { width: 100%; height: 80rpx; padding: 0 20rpx; background: #f7f7f7; border-radius: 14rpx; box-sizing: border-box; font-size: 25rpx; }
.field-tip { margin-top: 10rpx; color: #999; font-size: 21rpx; }
.submit-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 84rpx; margin-top: 34rpx; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1; background: #ff2442; border-radius: 999rpx; }
.submit-btn::after { border: 0; }
.notice { margin-top: 18rpx; color: #999; font-size: 21rpx; line-height: 1.6; }
.history-list { display: flex; flex-direction: column; width: 100%; margin-top: 12rpx; }
.history-item { display: flex; align-items: flex-start; justify-content: space-between; width: 100%; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.history-item:last-child { border-bottom: 0; }
.history-main { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.history-money { color: #222; font-size: 30rpx; font-weight: 750; }
.history-time,.history-note { margin-top: 7rpx; color: #999; font-size: 21rpx; line-height: 1.45; }
.status { flex-shrink: 0; max-width: 210rpx; margin-left: 20rpx; color: #a46d00; font-size: 22rpx; text-align: right; }
.status-PAID { color: #15935b; }
.status-REJECTED { color: #999; }
.empty { display: flex; align-items: center; justify-content: center; padding: 48rpx 0 30rpx; color: #aaa; font-size: 24rpx; }
