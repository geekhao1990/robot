<scroll-view
  class="profile-scroll"
  scroll-y
  scroll-top="{{profileScrollTop}}"
  refresher-enabled
  refresher-threshold="64"
  refresher-default-style="none"
  refresher-background="#f5f5f5"
  refresher-triggered="{{refreshing}}"
  bindrefresherpulling="onRefresherPulling"
  bindrefresherrefresh="onRefresherRefresh"
  bindrefresherrestore="onRefresherRestore"
  bindrefresherabort="onRefresherAbort"
  bindscroll="onProfileScroll"
>
  <view slot="refresher" class="refresh-indicator">
    <view wx:if="{{refreshing}}" class="refresh-loading"></view>
    <view wx:else class="refresh-arrow {{refreshReady ? 'is-ready' : ''}}">↓</view>
    <text>{{refreshing ? '刷新中' : (refreshReady ? '松开刷新' : '下拉刷新')}}</text>
  </view>
<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="hero-mask"></view>
    <view class="profile" style="margin-top: {{navBarHeight}}px;">
      <view wx:if="{{user}}" class="row">
        <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view class="meta">
          <view class="name">{{user.name}}</view>
          <view class="uid user-id" bindlongpress="copyUserId">ID：{{user.id}}（长按复制）</view>
          <view wx:if="{{entitlements.length}}" class="profile-rights">
            <view wx:for="{{entitlements}}" wx:key="type" class="profile-right {{item.type}}">{{item.name}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{user}}" class="desc">{{user.desc || '暂无简介'}}</view>
      <view wx:if="{{user}}" class="profile-actions">
        <view class="profile-action" bindtap="openProfileEditor">编辑资料</view>
        <view class="profile-action" bindtap="onLogout">退出登录</view>
      </view>
      <view wx:else class="login-prompt" bindtap="goLogin">
        <image class="avatar" src="https://i.pravatar.cc/150?img=68" mode="aspectFill" />
        <view class="meta"><view class="name">点击登录</view><view class="uid">使用微信账号登录</view></view>
      </view>
    </view>
  </view>
  <view wx:if="{{editingProfile}}" class="profile-editor">
    <view class="editor-title">编辑个人资料</view>
    <view class="editor-field">
      <view class="editor-label">头像</view>
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="editor-avatar" src="{{draftAvatar}}" mode="aspectFill" />
        <text>更换头像</text>
      </button>
    </view>
    <view class="editor-field">
      <view class="editor-label">昵称</view>
      <input class="nickname-input" type="nickname" maxlength="24" value="{{draftName}}" placeholder="请输入昵称" bindinput="onNameInput" />
    </view>
    <view class="editor-field">
      <view class="editor-label">Web密码</view>
      <input class="nickname-input" password maxlength="64" value="{{draftPassword}}" placeholder="至少6位，不修改可留空" bindinput="onPasswordInput" />
    </view>
    <view class="editor-field">
      <view class="editor-label">重复密码</view>
      <input class="nickname-input" password maxlength="64" value="{{draftPasswordConfirm}}" placeholder="再次输入密码" bindinput="onPasswordConfirmInput" />
    </view>
    <view class="editor-actions">
      <button class="editor-button cancel" bindtap="closeProfileEditor">取消</button>
      <button class="editor-button save" bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">保存</button>
    </view>
  </view>
  <view class="quick-menu {{editingProfile ? 'after-editor' : ''}}">
    <view class="quick-item" bindtap="openGiftModal"><image class="quick-icon" src="/images/profile-gift-card.png" mode="aspectFit" /><view class="quick-title">礼品卡</view></view>
    <view wx:if="{{user && user.darkFundEnabled}}" class="quick-item" bindtap="goDarkFunds"><image class="quick-icon" src="/images/profile-dark-funds.png" mode="aspectFit" /><view class="quick-title">暗盘资金</view></view>
    <view wx:if="{{user && user.goldAccess}}" class="quick-item" bindtap="goGoldNote"><image class="quick-icon" src="/images/profile-gold.png" mode="aspectFit" /><view class="quick-title">金手指</view></view>
    <view class="quick-item" bindtap="goMessageCenter">
      <view class="quick-icon-wrap"><image class="quick-icon" src="/images/profile-messages.svg" mode="aspectFit" /><view wx:if="{{messageUnread}}" class="quick-badge">{{messageUnread}}</view></view>
      <view class="quick-title">消息中心</view>
    </view>
  </view>
  <view wx:if="{{serviceQrAccess}}" class="service-actions">
    <view class="service-button" bindtap="openEnterpriseWechat">
      <view class="service-icon">企</view>
      <view class="service-copy"><view class="service-title">咨询人工</view><view class="service-description">售前咨询及售后服务</view></view>
    </view>
    <view class="service-button" bindtap="openWechatPayment">
      <view class="service-icon payment">收</view>
      <view class="service-copy"><view class="service-title">老客扫码复购</view><view class="service-description">微信二维码</view></view>
    </view>
  </view>
  <block wx:if="{{loggedIn}}">
    <view class="tabs"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{tabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onTab">{{item}}</view></view>
    <view class="list">
      <view class="waterfall" hidden="{{!currentNotes.length}}">
        <view class="column"><note-card wx:for="{{left}}" wx:key="id" note="{{item}}" bindopen="goDetail" /></view>
        <view class="column"><note-card wx:for="{{right}}" wx:key="id" note="{{item}}" bindopen="goDetail" /></view>
      </view>
      <view class="placeholder" hidden="{{currentNotes.length}}">{{emptyText}}</view>
    </view>
  </block>
  <view wx:if="{{loggedIn && profileBottomAdUnitId && !profileBottomAdLoadFailed}}" class="profile-bottom-ad">
    <ad unit-id="{{profileBottomAdUnitId}}" binderror="onProfileBottomAdError" />
  </view>
</view>
</scroll-view>
<view wx:if="{{serviceQrVisible}}" class="service-qr-mask" catchtap="closeServiceQr">
  <view class="service-qr-sheet" catchtap="noop">
    <view class="service-qr-handle"></view>
    <view class="service-qr-title">{{serviceQrTitle}}</view>
    <view class="service-qr-description">{{serviceQrDescription}}</view>
    <image class="service-qr-image" src="{{serviceQrImage}}" mode="widthFix" bindtap="previewServiceQr" show-menu-by-longpress />
    <view class="service-qr-tip">点击查看大图，长按可识别或保存</view>
  </view>
</view>
<view wx:if="{{giftModalVisible}}" class="gift-mask" catchtap="closeGiftModal">
  <view class="gift-panel" catchtap="noop">
    <view class="gift-panel-head"><view><view class="gift-title">礼品卡</view><view class="gift-description">输入卡密兑换对应权益</view></view><view class="gift-close" catchtap="closeGiftModal">×</view></view>
    <view class="gift-input-row">
      <input class="gift-input" value="{{giftCode}}" bindinput="onGiftCodeInput" maxlength="80" placeholder="请输入礼品卡卡密" disabled="{{redeemingGift}}" />
      <button class="gift-redeem" bindtap="redeemGift" loading="{{redeemingGift}}" disabled="{{redeemingGift}}">兑换</button>
    </view>
  </view>
</view>
