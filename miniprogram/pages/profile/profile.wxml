<view class="page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="hero-mask"></view>
    <view class="profile" style="margin-top: {{navBarHeight}}px;">
      <view wx:if="{{user}}" class="row">
        <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view class="meta"><view class="name">{{user.name}}</view><view class="uid">{{accessText}}</view></view>
      </view>
      <view wx:if="{{user}}" class="desc">{{user.desc || '暂无简介'}}</view>
      <view wx:if="{{user}}" class="profile-actions">
        <view class="profile-action" bindtap="openProfileEditor">编辑资料</view>
        <view class="profile-action" bindtap="onLogout">退出登录</view>
      </view>
      <view wx:else class="login-prompt" bindtap="goLogin">
        <image class="avatar" src="https://i.pravatar.cc/150?img=68" mode="aspectFill" />
        <view class="meta"><view class="name">点击登录</view><view class="uid">使用微信账号登录</view></view>
      </view>
    </view>
  </view>
  <view wx:if="{{editingProfile}}" class="profile-editor">
    <view class="editor-title">编辑个人资料</view>
    <view class="editor-field">
      <view class="editor-label">头像</view>
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="editor-avatar" src="{{draftAvatar}}" mode="aspectFill" />
        <text>更换头像</text>
      </button>
    </view>
    <view class="editor-field">
      <view class="editor-label">昵称</view>
      <input class="nickname-input" type="nickname" maxlength="24" value="{{draftName}}" placeholder="请输入昵称" bindinput="onNameInput" />
    </view>
    <view class="editor-field">
      <view class="editor-label">手机号</view>
      <view class="phone-row">
        <text class="phone-value">{{phoneText}}</text>
        <button class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{bindingPhone}}" disabled="{{bindingPhone}}">{{user.phone ? '重新绑定' : '微信授权'}}</button>
      </view>
    </view>
    <view class="editor-actions">
      <button class="editor-button cancel" bindtap="closeProfileEditor">取消</button>
      <button class="editor-button save" bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">保存</button>
    </view>
  </view>
  <view class="points-entry {{editingProfile ? 'after-editor' : ''}}" bindtap="goPoints">
    <view class="points-icon">积</view>
    <view class="points-copy"><view class="points-title">积分中心</view><view class="points-sub">看广告、邀请好友赚积分</view></view>
    <view class="points-arrow">›</view>
  </view>
  <block wx:if="{{loggedIn}}">
    <view class="tabs"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{tabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onTab">{{item}}</view></view>
    <view class="list">
      <view wx:if="{{currentNotes.length}}" class="waterfall">
        <view class="column"><note-card wx:for="{{left}}" wx:key="id" note="{{item}}" bindtap="goDetail" /></view>
        <view class="column"><note-card wx:for="{{right}}" wx:key="id" note="{{item}}" bindtap="goDetail" /></view>
      </view>
      <view wx:else class="placeholder">{{emptyText}}</view>
    </view>
  </block>
</view>
