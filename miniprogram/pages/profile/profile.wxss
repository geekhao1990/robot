.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.hero {
  background: linear-gradient(135deg, #ff9a9e 0%, #ff2442 100%);
  padding-bottom: 30rpx;
  position: relative;
}
.profile {
  padding: 30rpx;
  color: #fff;
}
.row, .login-prompt {
  display: flex;
  align-items: center;
}
.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.6);
  margin-right: 24rpx;
}
.meta {
  flex: 1;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
}
.uid {
  font-size: 24rpx;
  opacity: .85;
  margin-top: 10rpx;
}
.desc {
  font-size: 26rpx;
  margin-top: 24rpx;
  opacity: .95;
}
.stats {
  display: flex;
  margin-top: 30rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 56rpx;
}
.stat .num {
  font-size: 34rpx;
  font-weight: 700;
}
.stat .label {
  font-size: 22rpx;
  opacity: .85;
  margin-top: 6rpx;
}
.logout {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.7);
  border-radius: 999rpx;
}

.member-panel {
  position: relative;
  z-index: 2;
  margin: -16rpx 20rpx 24rpx;
  padding: 28rpx 24rpx;
  background: #2f2f38;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.12);
}
.member-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.member-title { color: #f7dca0; font-size: 30rpx; font-weight: 700; }
.member-status { color: #a9a9b4; font-size: 22rpx; margin-top: 6rpx; }
.wechat-pay { color: #34b46e; font-size: 22rpx; }
.member-plans { display: flex; gap: 14rpx; }
.member-plan { flex: 1; padding: 20rpx 8rpx; text-align: center; background: #3b3b46; border: 2rpx solid #50505b; border-radius: 16rpx; }
.member-plan.paying { opacity: .6; }
.member-plan-name { color: #f5d9a8; font-size: 25rpx; font-weight: 600; }
.member-price { color: #fff; font-size: 38rpx; font-weight: 800; margin: 8rpx 0; }
.member-price text { font-size: 22rpx; }
.member-buy { color: #5a3d0a; background: #f5d18b; border-radius: 999rpx; padding: 8rpx 0; font-size: 21rpx; }

.tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  position: relative;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.active {
  color: #333;
  font-weight: 700;
}
.tab.active::after {
  content: '';
  display: block;
  width: 40rpx;
  height: 6rpx;
  background: #ff2442;
  border-radius: 999rpx;
  margin: 10rpx auto 0;
}

.list {
  padding: 12rpx;
}
/* 草稿卡片（笔记形式） */
.draft-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.d-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  background: #f0f0f0;
}
.d-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.d-noimg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 26rpx;
  background: #f7f7f7;
}
.d-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: #333;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  opacity: .85;
}
.d-info {
  padding: 16rpx;
}
.d-title {
  font-size: 27rpx;
  line-height: 1.4;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
