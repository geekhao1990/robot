.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.hero {
  background: linear-gradient(135deg, #ff9a9e 0%, #ff2442 100%);
  padding-bottom: 30rpx;
  position: relative;
}
.profile {
  padding: 30rpx;
  color: #fff;
}
.row, .login-prompt {
  display: flex;
  align-items: center;
}
.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.6);
  margin-right: 24rpx;
}
.meta {
  flex: 1;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
}
.uid {
  font-size: 24rpx;
  opacity: .85;
  margin-top: 10rpx;
}
.desc {
  font-size: 26rpx;
  margin-top: 24rpx;
  opacity: .95;
}
.stats {
  display: flex;
  margin-top: 30rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 56rpx;
}
.stat .num {
  font-size: 34rpx;
  font-weight: 700;
}
.stat .label {
  font-size: 22rpx;
  opacity: .85;
  margin-top: 6rpx;
}
.logout {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.7);
  border-radius: 999rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  position: relative;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.active {
  color: #333;
  font-weight: 700;
}
.tab.active::after {
  content: '';
  display: block;
  width: 40rpx;
  height: 6rpx;
  background: #ff2442;
  border-radius: 999rpx;
  margin: 10rpx auto 0;
}

.list {
  padding: 12rpx;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
