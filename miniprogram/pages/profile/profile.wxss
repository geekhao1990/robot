.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.hero {
  background: linear-gradient(135deg, #ff9a9e 0%, #ff2442 100%);
  padding-bottom: 30rpx;
  position: relative;
}
.profile {
  padding: 30rpx;
  color: #fff;
}
.row, .login-prompt {
  display: flex;
  align-items: center;
}
.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.6);
  margin-right: 24rpx;
}
.meta {
  flex: 1;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
}
.uid {
  font-size: 24rpx;
  opacity: .85;
  margin-top: 10rpx;
}
.desc {
  font-size: 26rpx;
  margin-top: 24rpx;
  opacity: .95;
}
.stats {
  display: flex;
  margin-top: 30rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 56rpx;
}
.stat .num {
  font-size: 34rpx;
  font-weight: 700;
}
.stat .label {
  font-size: 22rpx;
  opacity: .85;
  margin-top: 6rpx;
}
.profile-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}
.profile-action {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.7);
  border-radius: 999rpx;
}

.profile-editor {
  position: relative;
  z-index: 3;
  margin: -16rpx 20rpx 24rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08);
}
.editor-title { color: #222; font-size: 32rpx; font-weight: 700; margin-bottom: 14rpx; }
.editor-field { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #f2f2f2; }
.editor-label { width: 116rpx; color: #555; font-size: 27rpx; }
.avatar-picker, .editor-button { margin: 0; padding: 0; background: transparent; line-height: normal; }
.avatar-picker::after, .editor-button::after { border: none; }
.avatar-picker { display: flex; flex: 1; align-items: center; justify-content: flex-start; color: #ff2442; font-size: 25rpx; }
.editor-avatar { width: 72rpx; height: 72rpx; margin-right: 18rpx; border-radius: 50%; background: #f2f2f2; }
.nickname-input { flex: 1; height: 72rpx; color: #222; font-size: 28rpx; }
.editor-actions { display: flex; gap: 18rpx; margin-top: 28rpx; }
.editor-button { display: flex; flex: 1; align-items: center; justify-content: center; height: 72rpx; border-radius: 999rpx; font-size: 27rpx; }
.editor-button.cancel { color: #666; background: #f5f5f5; }
.editor-button.save { color: #fff; background: #ff2442; }

.points-entry {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin: -16rpx 20rpx 24rpx;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08);
}
.points-entry.after-editor { margin-top: 0; }
.points-icon { width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center; color: #fff; font-size: 28rpx; font-weight: 700; background: #ff2442; border-radius: 50%; }
.points-copy { flex: 1; margin-left: 20rpx; }
.points-title { color: #222; font-size: 30rpx; font-weight: 700; }
.points-sub { color: #999; font-size: 23rpx; margin-top: 6rpx; }
.points-arrow { color: #bbb; font-size: 48rpx; font-weight: 300; }

.tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  position: relative;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.active {
  color: #333;
  font-weight: 700;
}
.tab.active::after {
  content: '';
  display: block;
  width: 40rpx;
  height: 6rpx;
  background: #ff2442;
  border-radius: 999rpx;
  margin: 10rpx auto 0;
}

.list {
  padding: 12rpx;
}
/* 草稿卡片（笔记形式） */
.draft-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.d-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  background: #f0f0f0;
}
.d-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.d-noimg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 26rpx;
  background: #f7f7f7;
}
.d-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: #333;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  opacity: .85;
}
.d-info {
  padding: 16rpx;
}
.d-title {
  font-size: 27rpx;
  line-height: 1.4;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
