.profile-scroll { position: fixed; top: 0; right: 0; bottom: 0; left: 0; }
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.hero {
  background: linear-gradient(135deg, #ff9a9e 0%, #ff2442 100%);
  padding-bottom: 30rpx;
  position: relative;
}
.profile {
  padding: 30rpx;
  color: #fff;
}
.row, .login-prompt {
  display: flex;
  align-items: center;
}
.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.6);
  margin-right: 24rpx;
}
.meta {
  flex: 1;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
}
.uid {
  font-size: 24rpx;
  opacity: .85;
  margin-top: 10rpx;
}
.user-id { user-select: text; }
.profile-rights {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}
.profile-right {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  height: 36rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  color: #69430a;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 36rpx;
  letter-spacing: 1rpx;
  background: linear-gradient(135deg, #fff1bd 0%, #edc66a 55%, #d9a93d 100%);
  border: 1rpx solid rgba(255,243,190,.86);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(105,67,10,.15);
}
.profile-right.gold {
  color: #5b3908;
  background: linear-gradient(135deg, #ffeaaa 0%, #e8b94f 100%);
}
.desc {
  font-size: 26rpx;
  margin-top: 24rpx;
  opacity: .95;
}
.stats {
  display: flex;
  margin-top: 30rpx;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 56rpx;
}
.stat .num {
  font-size: 34rpx;
  font-weight: 700;
}
.stat .label {
  font-size: 22rpx;
  opacity: .85;
  margin-top: 6rpx;
}
.profile-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}
.profile-action {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.7);
  border-radius: 999rpx;
}

.profile-editor {
  position: relative;
  z-index: 3;
  margin: -16rpx 20rpx 24rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08);
}
.editor-title { color: #222; font-size: 32rpx; font-weight: 700; margin-bottom: 14rpx; }
.editor-field { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #f2f2f2; }
.editor-label { width: 116rpx; color: #555; font-size: 27rpx; }
.avatar-picker, .editor-button { margin: 0; padding: 0; background: transparent; line-height: normal; }
.avatar-picker::after, .editor-button::after { border: none; }
.avatar-picker { display: flex; flex: 1; align-items: center; justify-content: flex-start; color: #ff2442; font-size: 25rpx; }
.editor-avatar { width: 72rpx; height: 72rpx; margin-right: 18rpx; border-radius: 50%; background: #f2f2f2; }
.nickname-input { flex: 1; height: 72rpx; color: #222; font-size: 28rpx; }
.editor-readonly { flex: 1; min-width: 0; color: #888; font-size: 27rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.editor-copy { flex: 0 0 auto; padding: 14rpx 0 14rpx 24rpx; color: #ff2442; font-size: 26rpx; }
.editor-web-tip { padding-top: 16rpx; color: #999; font-size: 20rpx; line-height: 1.5; word-break: break-all; }
.editor-actions { display: flex; gap: 18rpx; margin-top: 28rpx; }
.editor-button { display: flex; flex: 1; align-items: center; justify-content: center; height: 72rpx; border-radius: 999rpx; font-size: 27rpx; }
.editor-button.cancel { color: #666; background: #f5f5f5; }
.editor-button.save { color: #fff; background: #ff2442; }

.quick-menu {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  margin: -16rpx 20rpx 24rpx;
  padding: 26rpx 12rpx 22rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08);
}
.quick-menu.after-editor { margin-top: 0; }
.quick-item { display: flex; flex: 0 0 16.6667%; width: 16.6667%; min-width: 0; flex-direction: column; align-items: center; justify-content: flex-start; }
.quick-icon-wrap { position: relative; width: 56rpx; height: 56rpx; }
.quick-icon { width: 56rpx; height: 56rpx; }
.quick-badge { position: absolute; top: -10rpx; right: -16rpx; display: flex; align-items: center; justify-content: center; min-width: 28rpx; height: 28rpx; padding: 0 5rpx; color: #fff; font-size: 17rpx; font-weight: 700; line-height: 1; background: #ff2442; border: 3rpx solid #fff; border-radius: 999rpx; box-sizing: border-box; }
.quick-title { max-width: 100%; margin-top: 10rpx; color: #333; font-size: 20rpx; font-weight: 600; line-height: 1.2; white-space: nowrap; }
.service-actions { position: relative; z-index: 2; display: flex; gap: 16rpx; margin: 0 20rpx 24rpx; }
.service-button { display: flex; flex: 1; min-width: 0; align-items: center; padding: 24rpx 20rpx; background: #fff; border-radius: 20rpx; box-sizing: border-box; }
.service-icon { display: flex; flex: 0 0 68rpx; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-right: 16rpx; color: #2474d2; font-size: 30rpx; font-weight: 800; background: #e9f4ff; border-radius: 20rpx; }
.service-icon.payment { color: #16a05d; background: #e8f7ed; }
.service-copy { min-width: 0; }
.service-title { color: #333; font-size: 26rpx; font-weight: 700; white-space: nowrap; }
.service-description { margin-top: 8rpx; overflow: hidden; color: #999; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  position: relative;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.active {
  color: #333;
  font-weight: 700;
}
.tab.active::after {
  content: '';
  display: block;
  width: 40rpx;
  height: 6rpx;
  background: #ff2442;
  border-radius: 999rpx;
  margin: 10rpx auto 0;
}

.list {
  padding: 12rpx;
}
.profile-bottom-ad { margin: 20rpx 20rpx calc(30rpx + env(safe-area-inset-bottom)); overflow: hidden; border-radius: 16rpx; }
/* 草稿卡片（笔记形式） */
.draft-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.d-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  background: #f0f0f0;
}
.d-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.d-noimg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 26rpx;
  background: #f7f7f7;
}
.d-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: #333;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  opacity: .85;
}
.d-info {
  padding: 16rpx;
}
.d-title {
  font-size: 27rpx;
  line-height: 1.4;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
.gift-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1200; display: flex; align-items: flex-end; background: rgba(0,0,0,.45); }
.gift-panel { width: 100%; margin-bottom: 120rpx; padding: 34rpx 30rpx 10px; box-sizing: border-box; background: #fff; border-radius: 30rpx 30rpx 0 0; }
.gift-panel-head { display: flex; align-items: flex-start; justify-content: space-between; }
.gift-close { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; color: #999; font-size: 46rpx; line-height: 1; }
.gift-title { font-size: 30rpx; font-weight: 600; color: #333; }
.gift-description { margin-top: 10rpx; font-size: 24rpx; color: #888; }
.gift-input-row { display: flex; align-items: center; margin-top: 22rpx; }
.gift-input { flex: 1; min-width: 0; height: 80rpx; padding: 0 18rpx; border-radius: 12rpx; background: #f6f6f6; font-size: 24rpx; }
.gift-redeem { flex: 0 0 120rpx; margin: 0 0 0 16rpx; padding: 0; height: 80rpx; line-height: 80rpx; background: #ff2442; color: white; font-size: 26rpx; border-radius: 12rpx; }
.gift-redeem::after { border: none; }
.service-qr-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1300; display: flex; align-items: flex-end; justify-content: center; background: rgba(0,0,0,.48); }
.service-qr-sheet { width: 100%; padding: 20rpx 48rpx calc(32rpx + env(safe-area-inset-bottom)); text-align: center; background: #fff; border-radius: 36rpx 36rpx 0 0; box-sizing: border-box; animation: service-sheet-in .22s ease-out; }
.service-qr-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; background: #ddd; border-radius: 999rpx; }
.service-qr-title { color: #222; font-size: 38rpx; font-weight: 750; }
.service-qr-description { margin: 14rpx 0 24rpx; color: #999; font-size: 24rpx; line-height: 1.5; }
.service-qr-image { display: block; width: 70vw; max-width: 560rpx; margin: 0 auto; border-radius: 18rpx; }
.service-qr-tip { margin-top: 16rpx; color: #aaa; font-size: 21rpx; }
@keyframes service-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
