<view class="page">
  <view wx:if="{{messageCenterAdUnitId && !messageCenterAdLoadFailed}}" class="message-ad-slot">
    <ad unit-id="{{messageCenterAdUnitId}}" binderror="onMessageCenterAdError" />
  </view>
  <view class="message-head">
    <text class="head-title">全部消息</text>
  </view>

  <view wx:if="{{loading}}" class="empty">正在加载...</view>
  <view wx:elif="{{!list.length}}" class="empty">
    <view class="empty-icon">✉</view>
    <view>暂时没有消息</view>
  </view>
  <view wx:else class="message-list">
    <view wx:for="{{list}}" wx:key="id" class="message-item {{item.unread ? 'unread' : ''}}" data-id="{{item.id}}" bindtap="openMessage">
      <view class="message-icon {{item.type}}">{{item.iconText}}</view>
      <view class="message-body">
        <view class="message-title-row"><text class="message-title">{{item.title}}</text><text class="message-time">{{item.timeText}}</text></view>
        <view class="message-content">{{item.content}}</view>
      </view>
      <view wx:if="{{item.unread}}" class="unread-dot"></view>
      <view class="arrow">›</view>
    </view>
  </view>
  <view wx:if="{{!loading && list.length}}" class="message-pagination">
    <view class="page-button {{page <= 1 ? 'disabled' : ''}}" data-page="{{page - 1}}" bindtap="changePage">上一页</view>
    <view class="page-number">第 {{page}} / {{totalPages}} 页</view>
    <view class="page-button {{page >= totalPages ? 'disabled' : ''}}" data-page="{{page + 1}}" bindtap="changePage">下一页</view>
  </view>
  <view wx:if="{{!loading && list.length && messageCenterBottomAdUnitId && !messageCenterBottomAdLoadFailed}}" class="message-ad-slot message-ad-bottom">
    <ad unit-id="{{messageCenterBottomAdUnitId}}" binderror="onMessageCenterBottomAdError" />
  </view>
</view>
