.page {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 110rpx;
}

/* 导航 */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.nav-inner {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.back {
  font-size: 56rpx;
  line-height: 1;
  color: #333;
  width: 56rpx;
}
.nav-author {
  flex: 1;
  min-width: 0;
}
.nav-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.nav-name {
  font-size: 28rpx;
  font-weight: 600;
}
.follow-btn {
  background: #ff2442;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
}
.follow-btn.followed {
  background: #f3f3f3;
  color: #999;
}

.body {
  height: 100vh;
  box-sizing: border-box;
}

/* 图片 */
.swiper-wrap {
  position: relative;
}
.swiper {
  width: 100%;
}
.swiper-img {
  width: 100%;
  height: 100%;
}
.dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dot {
  width: 10rpx;
  height: 10rpx;
  margin: 0 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .55);
  transition: width .2s ease, background .2s ease;
}
.dot.active {
  width: 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

/* 正文 */
.article {
  padding: 30rpx 30rpx 20rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 20rpx;
}
.text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #333;
  white-space: pre-wrap;
}
.tags {
  margin-top: 20rpx;
}
.tag {
  color: #13386c;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.meta {
  color: #bbb;
  font-size: 24rpx;
  margin-top: 24rpx;
}

.divider {
  height: 16rpx;
  background: #f5f5f5;
}

/* 评论 */
.comments {
  padding: 24rpx 30rpx 40rpx;
}
.comments-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}
.comment {
  display: flex;
  margin-bottom: 32rpx;
}
.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.c-body {
  flex: 1;
}
.c-name {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.c-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}
.c-time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}
.c-like {
  flex-direction: column;
  color: #999;
  font-size: 22rpx;
}
.c-like-num {
  margin-top: 4rpx;
}
.comments-end {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  padding: 30rpx 0;
}

/* 底部操作栏 */
.actionbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.comment-input {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  background: #f3f3f3;
  border-radius: 999rpx;
  padding: 0 28rpx;
  color: #999;
  font-size: 26rpx;
  margin-right: 20rpx;
}
.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 76rpx;        /* 固定占位，点亮时不抖动 */
  flex-shrink: 0;
}
.ic {
  width: 44rpx;
  height: 44rpx;
  background-size: 100% 100%;
  background-repeat: no-repeat;
}
.ic.heart {
  background-image: url("data:image/svg+xml;base64,");
}
.ic.heart.active {
  background-image: url("data:image/svg+xml;base64,");
  animation: pop .3s ease;
}
.ic.star {
  background-image: url("data:image/svg+xml;base64,");
}
.ic.star.active {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0iI2ZmYjQwMCI+PHBhdGggZD0iTTEyIDMuMmwyLjYgNS41IDYgLjYtNC40IDQuMSAxLjIgNS45TDEyIDE2LjYgNi42IDE5LjNsMS4yLTUuOUwzLjQgOS4zbDYtLjZ6Ii8+PC9zdmc+");
  animation: pop .3s ease;
}
.ic.chat {
  background-image: url("data:image/svg+xml;base64,");
}
.num {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
  line-height: 1;
}
@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}
