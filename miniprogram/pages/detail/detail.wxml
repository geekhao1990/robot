<view class="page" wx:if="{{note}}">
  <view class="nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner" style="height: {{navBarHeight}}px;">
      <view class="back" bindtap="goBack">‹</view>
      <view class="nav-author flex">
        <image class="nav-avatar" src="{{note.author.avatar}}" mode="aspectFill" />
        <text class="nav-name">{{note.author.name}}</text>
        <view class="follow-btn {{followed ? 'followed' : ''}}" bindtap="onFollow">
          {{followed ? '已关注' : '+ 关注'}}
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="body" scroll-y style="padding-top: {{headerHeight}}px;">
    <view class="swiper-wrap">
      <swiper class="swiper" style="height: {{swiperHeight}}rpx;" bindchange="onSwiperChange" circular="{{false}}">
        <swiper-item wx:for="{{note.images}}" wx:key="*this">
          <image class="swiper-img" src="{{item}}" mode="aspectFill" bindtap="onNoteImageTap" data-index="{{index}}" data-url="{{item}}" />
        </swiper-item>
      </swiper>
      <view wx:if="{{note.images.length > 1}}" class="dots">
        <view wx:for="{{note.images}}" wx:key="*this" class="dot {{current === index ? 'active' : ''}}"></view>
      </view>
    </view>
    <view class="article">
      <view class="title">{{note.title}}</view>
      <view class="text">{{note.displayContent}}</view>
      <view class="tags"><text wx:for="{{note.tags}}" wx:key="*this" class="tag">#{{item}}</text></view>
      <view class="meta">{{timeText}}</view>
      <view class="actionbar">
        <view class="course-btn" bindtap="onGetResource">{{resourceLabel}}</view>
        <view class="action" bindtap="onLike">
          <view class="ic heart {{note.liked ? 'active' : ''}}"></view><text class="num">{{likeText}}</text>
        </view>
        <view class="action" bindtap="onCollect">
          <view class="ic star {{note.collected ? 'active' : ''}}"></view><text class="num">{{collectText}}</text>
        </view>
        <button class="action share-action" open-type="share">
          <view class="ic share"></view><text class="num">分享</text>
        </button>
        <view class="action" bindtap="goService">
          <view class="ic chat"></view><text class="num">客服</text>
        </view>
      </view>
    </view>
    <view class="detail-bottom-spacer"></view>
  </scroll-view>
</view>
<view wx:else class="placeholder"></view>

<persistent-tab-bar />

<view wx:if="{{resourceModalVisible}}" class="resource-mask" catchtap="closeResourceModal">
  <view class="resource-panel" catchtap="noop">
    <view class="resource-title">选择领取方式</view>
    <view class="resource-subtitle">链接复制后，打开对应网盘即可领取</view>
    <view class="resource-list">
      <view wx:for="{{resourceOptions}}" wx:key="provider" class="resource-item {{item.provider}}">
        <view class="resource-brand">
          <view class="resource-logo">{{item.provider === 'quark' ? '夸' : '度'}}</view>
          <text>{{item.name}}</text>
        </view>
        <button class="resource-copy" data-index="{{index}}" bindtap="copyResourceLink">复制链接</button>
      </view>
    </view>
    <view class="resource-close" bindtap="closeResourceModal">关闭</view>
  </view>
</view>

<view wx:if="{{vipModalVisible}}" class="vip-mask" catchtap="closeVipOffer">
  <view class="vip-panel" catchtap="noop">
    <view class="vip-dismiss" bindtap="closeVipOffer">×</view>
    <view class="vip-hero">
      <view class="vip-topline">
        <view class="vip-badge">牛来 VIP</view>
        <view class="vip-gift-tag">买1个月 · 可得2个月</view>
      </view>
      <view class="vip-plan-name">月卡会员</view>
      <view class="vip-price-row">
        <text class="vip-currency">¥</text>
        <text class="vip-price">9.9</text>
        <text class="vip-cycle">/ 30天</text>
      </view>
      <view class="vip-subtitle">微信支付 · 支付成功立即生效</view>
    </view>
    <view class="vip-body">
      <view class="vip-section-title">月卡权益</view>
      <view class="vip-benefit">
        <view class="vip-benefit-item">
          <view class="vip-benefit-icon">资</view>
          <view class="vip-benefit-copy"><text>课程资料领取</text><text>解锁网盘资源领取资格</text></view>
        </view>
        <view class="vip-benefit-item">
          <view class="vip-benefit-icon">金</view>
          <view class="vip-benefit-copy"><text>金手指数据</text><text>查看会员专属数据页面</text></view>
        </view>
        <view class="vip-benefit-item">
          <view class="vip-benefit-icon">赠</view>
          <view class="vip-benefit-copy"><text>添加企业微信再送30天</text><text>提供订单号人工核销，每个账号限一次</text></view>
        </view>
      </view>
      <view class="vip-gift-note"><text>买一送一</text><text>完成核销后，月卡有效期最长可达60天</text></view>
      <button class="vip-pay" bindtap="onBuyVip" loading="{{paymentPending}}" disabled="{{paymentPending}}">立即开通 · ¥9.9</button>
      <view class="vip-safe">微信安全支付</view>
      <view class="vip-close" bindtap="closeVipOffer">暂不开通</view>
    </view>
  </view>
</view>
