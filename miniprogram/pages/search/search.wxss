.page {
  min-height: 100vh;
  background: #f5f5f5;
}
.header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #fff;
}
.bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.input-wrap {
  flex: 1;
  height: 64rpx;
  background: #f3f3f3;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}
.s-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
}
.clear {
  color: #bbb;
  font-size: 26rpx;
  padding: 0 8rpx;
}
.cancel {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.content {
  padding: 20rpx 24rpx;
}
.block {
  margin-bottom: 40rpx;
}
.block-head {
  margin-bottom: 24rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: 600;
}
.block-clear {
  font-size: 28rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
}
.word {
  background: #fff;
  color: #333;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
}
.word.hot {
  background: #fff0f2;
  color: #ff2442;
}

.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
