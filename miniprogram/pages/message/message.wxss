.page {
  min-height: 100vh;
  background: #fff;
}

/* 未登录 */
.login-tip {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-tip-text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}
.login-tip-btn {
  background: #ff2442;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 999rpx;
}

/* 通知入口 */
.entries {
  display: flex;
  padding: 40rpx 0;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.entry-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff2442;
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry-label {
  font-size: 26rpx;
  color: #333;
  margin-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 30rpx;
  border-top: 16rpx solid #f5f5f5;
}

/* 私信列表 */
.chat-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}
.chat-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}
.chat-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.unread {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff2442;
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-body {
  flex: 1;
  min-width: 0;
}
.chat-top {
  width: 100%;
}
.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.chat-time {
  font-size: 22rpx;
  color: #bbb;
}
.chat-last {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  max-width: 520rpx;
}
