page {
  background: #f5f6f8;
}
.legal-page {
  height: 100vh;
  box-sizing: border-box;
}
.legal-card {
  margin: 24rpx;
  padding: 40rpx 34rpx 60rpx;
  background: #fff;
  border-radius: 20rpx;
  color: #333;
}
.legal-title {
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #111;
}
.legal-date {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.legal-intro {
  margin-top: 30rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #555;
}
.legal-section {
  margin-top: 34rpx;
}
.legal-section-title {
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 700;
  color: #222;
}
.legal-section-content {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.9;
  color: #555;
  white-space: pre-wrap;
}
