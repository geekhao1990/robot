@import "../../styles/dark-flow-fonts.wxss";
@import "../../styles/gold-finger-table.wxss";

.page { min-height: 100vh; padding: 24rpx 5px 70rpx; color: #333; font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif; background: #fff; box-sizing: border-box; }
.error { display: flex; align-items: center; justify-content: center; min-height: 70vh; color: #999; font-size: 26rpx; }
.result-skeleton { min-height: 100vh; }
.skeleton-card { margin-bottom: 24rpx; padding: 30rpx; overflow: hidden; background: #fff; border-radius: 26rpx; box-sizing: border-box; }
.skeleton-hero { display: flex; align-items: center; justify-content: space-between; }
.skeleton-line, .skeleton-tabs view, .skeleton-summary view, .skeleton-chart view, .skeleton-row view { background: linear-gradient(100deg, #eef0f3 20%, #f8f9fa 40%, #eef0f3 60%); background-size: 220% 100%; animation: skeleton-shimmer 1.2s ease-in-out infinite; border-radius: 10rpx; }
.skeleton-line { width: 44%; height: 30rpx; }
.skeleton-line.wide { width: 48%; height: 42rpx; }
.skeleton-line.short { width: 25%; height: 24rpx; }
.skeleton-line.title { width: 34%; height: 38rpx; margin-bottom: 28rpx; }
.skeleton-tabs { display: flex; gap: 10rpx; margin-bottom: 26rpx; }
.skeleton-tabs view { flex: 1; height: 68rpx; }
.skeleton-summary { display: flex; gap: 20rpx; margin-bottom: 30rpx; }
.skeleton-summary view { flex: 1; height: 150rpx; }
.skeleton-chart { display: flex; align-items: center; justify-content: space-around; height: 300rpx; border-bottom: 2rpx solid #eef0f3; }
.skeleton-chart view { width: 54rpx; height: 150rpx; }
.skeleton-chart view:nth-child(2) { height: 210rpx; }
.skeleton-chart view:nth-child(3) { height: 120rpx; }
.skeleton-row { display: flex; gap: 14rpx; padding: 20rpx 0; }
.skeleton-row view { flex: 1; height: 28rpx; }
@keyframes skeleton-shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
.card { margin-bottom: 24rpx; padding: 30rpx 0; background: #fff; border-radius: 0; box-shadow: none; }
.hero { display: flex; flex-direction: column; align-items: stretch; padding: 20rpx 0; margin-bottom: 16rpx; }
.hero-main-row { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; width: 100%; }
.hero-stock { min-width: 0; white-space: nowrap; }
.stock-name { font-size: 38rpx; font-weight: 800; }
.stock-code { margin-left: 14rpx; color: #999; font-size: 23rpx; }
.trade-date { flex: none; color: #999; font-size: 22rpx; white-space: nowrap; }
.hero-action-row { display: flex; justify-content: space-between; gap: 10rpx; width: 100%; margin-top: 8rpx; }
.hero-action-row > .hero-poster-button:last-child { margin-left: auto; }
.hero-poster-button { display: inline-flex; align-items: center; justify-content: center; gap: 7rpx; min-width: 100rpx; height: 44rpx; padding: 0 12rpx; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 1; background: linear-gradient(100deg, #df1e2f, #ff4550); border-radius: 22rpx; box-shadow: 0 5rpx 12rpx rgba(223,30,47,.16); }
.hero-share-icon { flex: 0 0 27rpx; width: 27rpx; height: 27rpx; background: center / 100% 100% no-repeat url("data:image/svg+xml;base64,"); }
.hero-poster-button-secondary { color: #d92436; background: #fff2f4; border: 1rpx solid #ffc7cf; box-shadow: none; }
.hero-poster-button-secondary .hero-share-icon { background-image: url("data:image/svg+xml;base64,"); }
.hero-poster-button-hover { opacity: .82; }
.hero-poster-button.disabled { color: rgba(255,255,255,.78); background: #d96770; }
.section-heading { display: flex; align-items: center; gap: 16rpx; margin: 2rpx 0 24rpx; font-size: 36rpx; font-weight: 800; }
.segment-control { display: flex; gap: 6rpx; margin-bottom: 22rpx; padding: 7rpx; background: #f2f3f5; border: 2rpx solid #dfe3e8; border-radius: 16rpx; }
.segment { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 70rpx; color: #64748b; font-size: 26rpx; font-weight: 700; border-radius: 12rpx; }
.segment.active { color: #111; background: #fff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.10); }
.fund-heading-row { display: flex; align-items: center; gap: 18rpx; margin: 2rpx 0 22rpx; }
.fund-heading-row .section-heading { flex: none; margin: 0; font-size: 32rpx; }
.fund-period-tabs { flex: none; width: 288rpx; gap: 4rpx; margin: 0 0 0 auto; padding: 4rpx; border: 0; border-radius: 10rpx; }
.fund-period-tabs .segment { min-height: 44rpx; padding: 0 10rpx; font-size: 22rpx; font-weight: 500; border-radius: 8rpx; }
.fund-period-tabs .segment.active { color: #fff; background: #f33f3a; box-shadow: none; font-weight: 600; }
/* Scoped to 1-day: do not change the 3/5-day charts or history sheets. */
.one-day-flow { margin: 0; padding: 0 16rpx 16rpx; border: 1px solid #d5d5d5; box-sizing: border-box; color: #333; font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif; }
.one-day-menu { display: flex; align-items: center; justify-content: space-between; height: 84rpx; margin: 0 -16rpx 44rpx; padding: 0 16rpx; border-bottom: 1rpx solid #d5d5d5; pointer-events: none; }
.one-day-menu-item { position: relative; display: flex; align-items: center; height: 100%; padding-bottom: 6rpx; color: #666; font-size: 28rpx; font-weight: 400; white-space: nowrap; }
.one-day-menu-item.selected { color: #252525; font-size: 30rpx; font-weight: 700; }
.one-day-menu-indicator { position: absolute; bottom: 0; left: 50%; width: 40rpx; height: 8rpx; border-radius: 8rpx; background: #f33f3a; transform: translateX(-50%); }
.one-day-title { display: flex; align-items: center; min-height: 40rpx; margin-bottom: 34rpx; font-size: 28rpx; font-weight: 700; line-height: 1.3; white-space: nowrap; }
.one-day-title-mark { flex: none; width: 4rpx; height: 26rpx; margin-right: 17rpx; background: #d9343e; }
.one-day-title-arrow { flex: none; width: 0; height: 0; margin-left: 16rpx; border-top: 9rpx solid #666; border-right: 8rpx solid transparent; border-left: 8rpx solid transparent; }
.one-day-info { display: flex; flex: none; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-left: 20rpx; color: #999; }
.one-day-info-glyph { position: relative; width: 25rpx; height: 25rpx; border: 2rpx solid #999; border-radius: 50%; box-sizing: border-box; }
.one-day-info-dot, .one-day-info-stem { position: absolute; left: 50%; width: 3rpx; background: #999; transform: translateX(-50%); }
.one-day-info-dot { top: 4rpx; height: 3rpx; border-radius: 50%; }
.one-day-info-stem { top: 9rpx; height: 9rpx; border-radius: 2rpx; }
.one-day-hk-link { display: flex; flex: none; align-items: center; gap: 12rpx; margin-left: auto; padding-left: 10rpx; color: #5998c7; font-size: 24rpx; font-weight: 400; pointer-events: none; }
.one-day-hk-link text { text-decoration: none; }
.one-day-hk-arrow { width: 16rpx; height: 16rpx; margin-right: 6rpx; border-top: 2rpx solid #ccc; border-right: 2rpx solid #ccc; transform: rotate(45deg); }
.one-day-summary { display: flex; height: 120rpx; border-radius: 8rpx; background: #f6f6f6; }
.one-day-summary-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #777; font-family: "DarkFlowLabels", sans-serif; font-size: 24rpx; font-weight: 700; letter-spacing: -.4rpx; line-height: 1.25; }
.one-day-total { font-family: "Bahnschrift", "DarkFlowDigits", sans-serif; font-size: 28rpx; font-weight: 700; font-synthesis: weight; letter-spacing: -.6rpx; font-variant-numeric: tabular-nums; }
.one-day-chart { position: relative; height: 0; padding-top: 42%; margin-top: 0; margin-bottom: 20rpx; }
.one-day-zero { position: absolute; top: 47%; width: 47.56%; height: 1rpx; background: #d5d5d5; }
.one-day-zero.main { left: 1.22%; }
.one-day-zero.retail { right: 1.22%; }
.one-day-column { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.one-day-bar { position: absolute; width: 4.88%; transform: translateX(-50%); }
.one-day-bar.positive { bottom: 53%; border-radius: 4rpx 4rpx 0 0; background: #ff3833; }
.one-day-bar.negative { top: 47%; border-radius: 0 0 4rpx 4rpx; background: #00b65b; }
.one-day-value { position: absolute; font-family: "Bahnschrift", "DarkFlowDigits", sans-serif; font-size: 22rpx; font-weight: 400; font-synthesis: none; letter-spacing: -.6rpx; line-height: 1.2; font-variant-numeric: tabular-nums; white-space: nowrap; transform: translateX(-50%); }
.one-day-value.positive { margin-bottom: 4rpx; }
.one-day-value.negative { margin-top: 7rpx; }
.one-day-total.positive, .one-day-value.positive { color: #df4a43; }
.one-day-total.negative, .one-day-value.negative { color: #19a564; }
.one-day-name { position: absolute; bottom: -20rpx; color: #666; font-family: "DarkFlowLabels", sans-serif; font-size: 26rpx; font-weight: 400; line-height: 1.3; white-space: nowrap; transform: translateX(-50%); }
.chart-inline-title { display: flex; align-items: center; min-height: 58rpx; margin: 4rpx 0 34rpx; color: #222; font-size: 34rpx; font-weight: 800; line-height: 1; }
.chart-title-mark { width: 7rpx; height: 42rpx; margin-right: 18rpx; background: #ff3b30; }
.chart-title-arrow { width: 0; height: 0; margin-left: 20rpx; border-top: 15rpx solid #666; border-right: 13rpx solid transparent; border-left: 13rpx solid transparent; }
.summary-grid { display: flex; min-height: 180rpx; padding: 30rpx 16rpx; background: #f6f6f6; border-radius: 12rpx; box-sizing: border-box; }
.summary-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #777; font-size: 28rpx; font-weight: 400; }
.summary-value { font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif; font-size: 29rpx; font-weight: 700; line-height: 1; transform: scaleX(.86); }
.up { color: #df4a43!important; }
.down { color: #19a564!important; }
.flow-chart { position: relative; width: 100%; height: 330rpx; margin-top: 22rpx; margin-bottom: 30px; padding: 0 12rpx; font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif; box-sizing: border-box; }
.zero-line { position: absolute; top: 50%; right: 0; left: 0; height: 1rpx; background: #d4d4d4; }
.flow-columns { position: relative; z-index: 1; display: flex; height: 100%; }
.flow-column { position: relative; display: flex; flex: 1; justify-content: center; height: 100%; }
.flow-stack { position: absolute; display: flex; flex-direction: column; align-items: center; }
.flow-bar { width: 36rpx; min-height: 12rpx; }
.bar-up { background: #ff3b30; border-radius: 5rpx 5rpx 0 0; }
.bar-down { background: #00b85a; border-radius: 0 0 5rpx 5rpx; }
.flow-value { min-width: 128rpx; padding: 12rpx 0; font-size: 27rpx; font-weight: 700; line-height: 1; text-align: center; white-space: nowrap; transform: scaleX(.86); }
.flow-name { position: absolute; bottom: -30px; color: #666; font-size: 28rpx; font-weight: 400; white-space: nowrap; }
.trend-summary { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin: 14rpx 0 4rpx; padding: 22rpx 0; color: #777; font-family: "DarkFlowLabels", "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 24rpx; font-weight: 700; letter-spacing: -.4rpx; background: #f6f6f6; border-radius: 0; }
.trend-value { font-family: "Bahnschrift", "DarkFlowDigits", "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; font-weight: 700; font-synthesis: weight; letter-spacing: -.6rpx; font-variant-numeric: tabular-nums; }
.trend-chart-wrap { position: relative; width: 100%; height: 500rpx; margin-top: 8rpx; }
.trend-canvas { width: 100%; height: 500rpx; }
.trend-empty { display: flex; align-items: center; justify-content: center; min-height: 360rpx; color: #aaa; font-size: 24rpx; }
.detail-title { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; color: #333; font-size: 32rpx; font-weight: 800; }
.detail-card { padding-right: 0; padding-left: 0; overflow: hidden; }
.detail-card > .detail-title, .detail-card > .segment-control { margin-right: 0; margin-left: 0; }
.table { width: 100%; border: 2rpx solid #dfe3e8; border-radius: 14rpx; box-sizing: border-box; }
.tr { display: flex; min-height: 78rpx; border-top: 1rpx solid #e6e8eb; }
.tr:first-child { border-top: 0; }
.tr text { display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; padding: 0 6rpx; font-size: 28rpx; text-align: center; box-sizing: border-box; }
.tr text:first-child { flex: .72; justify-content: center; color: #111!important; text-align: center; }
.tr.th { color: #475569; font-weight: 750; background: #f3f4f6; }
.tr.th text { color: #475569!important; }
.tr.th text, .tr.th text:first-child { justify-content: center; padding-right: 4rpx; padding-left: 4rpx; text-align: center; }
.orders-table .tr text { padding-right: 3rpx; padding-left: 3rpx; font-size: 26rpx; }
.orders-table .tr text:first-child { padding-right: 3rpx; padding-left: 3rpx; }
.tr:not(.th) text { font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif; font-size: 27rpx; font-weight: 700; line-height: 1; transform: scaleX(.86); }
.disclaimer { padding: 8rpx 20rpx 40rpx; color: #aaa; font-size: 20rpx; line-height: 1.7; text-align: center; }
.share-poster-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1334px; pointer-events: none; }
.history-hint { font-size: 22rpx; color: #64748b; margin: 16rpx 0; }
.history-selected { font-size: 26rpx; margin: 12rpx 0; }
.history-selected text { margin-left: 18rpx; }
.history-track { display: inline-flex; padding: 8px 0; }
.history-column { width: 36px; flex-shrink: 0; text-align: center; border-radius: 12px; }
.history-column.selected { background: #edf1f6; }
.history-plot { height: 204px; position: relative; }
.history-zero { position: absolute; top: 102px; width: 100%; border-top: 1px solid #ccd5df; }
.history-bar { position: absolute; width: 22px; left: 7px; border-radius: 3px; }
.history-bar.positive { bottom: 102px; background: #db3931; }
.history-bar.negative { top: 102px; background: #218207; }
.history-gs { display: inline-block; width: 18px; height: 18px; line-height: 18px; box-sizing: border-box; text-align: center; border-radius: 4px; font-size: 11px; font-weight: 700; margin-top: 8px; }
.signal-g { color: #cf342c; background: #fff0ee; border: 1px solid #f3b7af; }
.signal-s { color: #218207; background: #edf7e8; border: 1px solid #b9dba8; }
.signal-g.signal-change { color: white; background: #cf342c; border-color: #cf342c; }
.signal-s.signal-change { color: white; background: #218207; border-color: #218207; }
.signal-none { color: #7c899b; background: #edf1f6; border: 1px solid #edf1f6; }
.history-signal-label { display: inline-block; padding: 3rpx 12rpx; border-radius: 18rpx; font-size: 22rpx; vertical-align: middle; }
.history-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; font-size: 20rpx; color: #64748b; margin-top: 20rpx; }
.history-legend .history-gs { margin-top: 0; }
.history-scroll { width: 100%; white-space: nowrap; }
.history-sheet .detail-title { font-size: 31rpx; }
.history-date { font-size: 9px; color: #64748b; margin-top: 6px; }
.history-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 1000; display: flex; align-items: flex-end; }
.history-sheet { width: 100%; box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; background: white; padding: 32rpx 20rpx calc(32rpx + env(safe-area-inset-bottom)); }
.history-metrics { display: flex; flex-wrap: wrap; background: #f5f7fa; border-radius: 24rpx; overflow: hidden; }
.history-metric { width: 25%; box-sizing: border-box; padding: 24rpx 4rpx; text-align: center; border: 1rpx solid #e0e5ec; color: #64748b; font-size: 22rpx; }
.history-metric.core { width: 33.3333%; }
.history-metric text { display: block; margin-top: 12rpx; font-size: 25rpx; font-weight: 700; }
.history-actions { display: flex; gap: 12rpx; margin-top: 30rpx; }
.history-actions button { flex: 1; padding: 26rpx 16rpx; line-height: 1.5; font-size: 28rpx; background: #1b5bd7; color: white; }
.history-actions button[disabled] { background: #cbd5e1; color: #64748b; }
.query-complete { flex: none; color: #278618; font-size: 19rpx; }
.query-heading { display: flex; align-items: center; gap: 16rpx; }
.query-heading-info { flex: 1; min-width: 0; }
.query-heading .hero-stock { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; }
.query-heading .stock-name { font-size: 34rpx; font-weight: 750; }
.query-heading .stock-code { margin-left: 0; font-size: 21rpx; color: #64748b; }
.query-heading .trade-date { font-size: 23rpx; color: #64748b; line-height: 1.6; margin-top: 14rpx; }
.query-heading-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 16rpx; flex-shrink: 0; }
.query-heading-actions .hero-poster-button { height: 68rpx; padding: 0 16rpx; border-radius: 36rpx; font-size: 24rpx; }
.history-navigation { display: flex; justify-content: space-between; margin-top: 12rpx; }
.history-navigation view { border: 1rpx solid #d6dde6; border-radius: 30rpx; padding: 8rpx 20rpx; font-size: 23rpx; color: #475569; }
.history-summary { margin-top: 22rpx; color: #64748b; font-size: 24rpx; line-height: 1.8; }
.hero-meta-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.header-meta { font-size: 20rpx; line-height: 1.5; color: #64748b; white-space: nowrap; }
.gold-preview-entry { flex: none; margin-left: auto; padding: 12rpx 14rpx; color: #96621d; background: #fff6e6; border: 1rpx solid #ecd5ad; border-radius: 24rpx; font-size: 22rpx; line-height: 1.4; white-space: nowrap; }
.gold-preview-entry.disabled { opacity: .55; }
.gold-preview-entry-hover { background: #ffedce; }
.gold-preview-mask { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0,0,0,.45); }
.gold-preview-sheet { width: 100%; max-height: 85vh; overflow-y: auto; padding: 36rpx 28rpx 28rpx; box-sizing: border-box; background: #fff; border-radius: 28rpx; }
.gold-preview-title-row { display: flex; align-items: center; }
.gold-preview-title { flex-shrink: 0; padding-left: 22rpx; color: #242424; font-size: 36rpx; font-weight: 850; border-left: 9rpx solid #ff2442; }
.gold-preview-date { margin-top: 12rpx; color: #7d8590; font-size: 23rpx; text-align: center; }
.gold-preview-update { flex: 1; min-width: 0; margin-left: 12rpx; color: #8a7864; font-size: 18rpx; line-height: 1.5; white-space: nowrap; }
.gold-preview-tips { margin-top: 24rpx; color: #8a7864; font-size: 23rpx; line-height: 1.7; text-align: center; }
.gold-preview-disclaimer { padding: 24rpx 0; color: #aaa095; font-size: 20rpx; text-align: center; }
.gold-preview-close { margin: 0; padding: 18rpx 24rpx; color: #fff; background: #e63846; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; }
.gold-preview-close::after { border: 0; }
.history-navigation { min-height: 52rpx; }
.history-navigation .history-today { margin-left: auto; }
.detail-pagination { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 0 0 24rpx; font-size: 23rpx; color: #64748b; }
.detail-pagination button { margin: 0; padding: 24rpx 48rpx; line-height: 1.5; font-size: 24rpx; background: white; }
.detail-date-cell { flex: 0 0 192rpx; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6rpx; padding: 12rpx 4rpx; box-sizing: border-box; white-space: nowrap; }
.detail-date-link { font-size: 26rpx; color: #1769df; text-decoration: underline; text-underline-offset: 4rpx; }
.detail-gs-tag { display: inline-block; font-size: 19rpx; line-height: 1.3; padding: 2rpx 8rpx; border-radius: 18rpx; white-space: nowrap; }
.detail-row-hover { background: #f0f5fc; }
.hero { position: relative; }
.hero .query-heading-actions { position: absolute; right: 24rpx; top: 24rpx; gap: 12rpx; }
.hero .hero-action-row { flex: none; width: auto; margin: 0; }
.hero .hero-poster-button { height: 44rpx; font-size: 20rpx; padding: 0 12rpx; }
.history-mask { backdrop-filter: blur(5px); }
.history-sheet { max-height: 90vh; overflow-y: auto; border-radius: 36rpx 36rpx 0 0; }
.history-handle { width: 68rpx; height: 7rpx; border-radius: 7rpx; background: #c7cdd5; margin: -12rpx auto 24rpx; }
.history-flow .chart-inline-title { font-size: 27rpx; margin: 16rpx 0; min-height: 36rpx; }
.history-flow .chart-title-mark { height: 28rpx; }
.history-flow .summary-grid { min-height: 112rpx; padding: 14rpx; border: 1rpx solid #e0e5ec; border-radius: 24rpx; }
.history-flow .summary-item { font-size: 24rpx; }
.history-flow .flow-chart { height: 300rpx; margin-bottom: 64rpx; }
.history-flow .flow-name { bottom: -42rpx; font-size: 24rpx; }
.history-flow .flow-value { font-size: 24rpx; }
.core-table .th text:first-child, .orders-table .th text:first-child { flex: 0 0 192rpx; }
.history-selected-amount { font-size: 34rpx; font-weight: 800; }
.history-date-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; margin: 8rpx 8rpx 24rpx; color: #20252b; }
.history-date-title { font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.history-date-heading .history-signal-label { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 20rpx; line-height: 1.3; padding: 3rpx 12rpx; }

/* The 1-day flow is the typography and colour reference for this page. */
.section-heading, .detail-title { color: #333; font-size: 32rpx; font-weight: 800; }
.query-complete { color: #19a564; }
.query-heading .stock-code, .header-meta, .history-summary, .history-legend, .history-date, .history-hint, .history-metric, .segment { color: #777; }
.gold-preview-entry { color: #5998c7; background: #fff; border-color: #d5d5d5; }
.gold-preview-entry-hover { background: #f6f6f6; }
.history-selected, .detail-date-link { color: #666; }
.history-selected-amount, .tr:not(.th) text, .summary-value, .flow-value, .history-metric text, .stock-code, .header-meta, .detail-date-link { font-family: "Bahnschrift", "DarkFlowDigits", "PingFang SC", "Microsoft YaHei", sans-serif; font-weight: 700; font-synthesis: weight; letter-spacing: -.6rpx; font-variant-numeric: tabular-nums; transform: none; }
.history-selected-amount { font-size: 28rpx; }
.tr.th, .tr.th text { color: #777!important; background: #f6f6f6; }
.table { border-color: #d5d5d5; border-radius: 0; }
.history-column.selected, .signal-none { background: #f6f6f6; }
.history-bar.positive, .bar-up { background: #ff3833; }
.history-bar.negative, .bar-down { background: #00b65b; }
.signal-g { color: #df4a43; background: #fff; border-color: #df4a43; }
.signal-s { color: #19a564; background: #fff; border-color: #19a564; }
.signal-g.signal-change { color: #fff; background: #df4a43; border-color: #df4a43; }
.signal-s.signal-change { color: #fff; background: #19a564; border-color: #19a564; }
.history-navigation view { color: #666; border-color: #d5d5d5; }
.history-actions button { background: #ff3833; }
.history-date-title { font-family: "PingFang SC", "Microsoft YaHei", Arial, sans-serif; }
.history-date-heading .history-signal-label { font-family: inherit; }
.gold-preview-sheet { font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; }
