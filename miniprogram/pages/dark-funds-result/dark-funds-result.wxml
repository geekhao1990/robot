<import src="../../templates/gold-finger-table.wxml" />
<view class="page">
  <view wx:if="{{loading}}" class="result-skeleton">
    <view class="skeleton-card skeleton-hero"><view class="skeleton-line wide"></view><view class="skeleton-line short"></view></view>
    <view class="skeleton-card">
      <view class="skeleton-line title"></view>
      <view class="skeleton-tabs"><view></view><view></view><view></view></view>
      <view class="skeleton-summary"><view></view><view></view></view>
      <view class="skeleton-chart"><view></view><view></view><view></view></view>
    </view>
    <view class="skeleton-card skeleton-table">
      <view class="skeleton-line title"></view>
      <view class="skeleton-tabs"><view></view><view></view></view>
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="skeleton-row"><view></view><view></view><view></view><view></view></view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="card hero">
      <view class="query-heading">
      <view class="query-heading-info">
        <view class="hero-stock"><text class="stock-name">{{result.stockName}}</text><text class="stock-code">{{result.displayCode}}</text></view>
      </view>
      <view class="query-complete">● 查询完成</view>
      </view>
      <view class="hero-meta-row">
      <view class="header-meta">数据时间 {{result.displayDataTime}}</view>
      <view class="gold-preview-entry {{goldPreviewLoading ? 'disabled' : ''}}" role="button" aria-disabled="{{goldPreviewLoading}}" bindtap="openGoldPreview" hover-class="gold-preview-entry-hover">{{goldPreviewLoading ? '正在加载…' : '查看今日金手指阴阳谱'}}</view>
      </view>
    </view>
    <view wx:if="{{goldPreviewModal}}" class="gold-preview-mask" bindtap="closeGoldPreview" catchtouchmove="stopHistoryTap">
      <view class="gold-preview-sheet" catchtap="stopHistoryTap">
        <view class="gold-preview-title-row"><view class="gold-preview-title">点金历史</view><view class="gold-preview-update">非实时更新，每半小时更新一次。</view></view>
        <template is="gold-finger-table" data="{{records: goldPreviewRecords}}" />
        <view wx:if="{{!goldPreviewIsToday}}" class="gold-preview-date">今日数据尚未更新，当前显示最近一期。</view>
        <view class="gold-preview-tips">Tips：阴阳谱接近20时，关注反转机会/风险，不代表必然反转。</view>
        <view class="gold-preview-disclaimer">数据来自互联网，仅供参考不构成投资建议</view>
        <button class="gold-preview-close" bindtap="closeGoldPreview">关闭</button>
      </view>
    </view>
    <view class="card fund-card">
      <view class="fund-heading-row">
      <view class="section-heading"><text>暗盘资金</text></view>
      <view class="segment-control fund-period-tabs">
        <view class="segment {{fundView === 'main' ? 'active' : ''}}" data-view="main" bindtap="switchFundView">1日</view>
        <view class="segment {{fundView === 'trend3' ? 'active' : ''}}" data-view="trend3" bindtap="switchFundView">3日</view>
        <view class="segment {{fundView === 'trend5' ? 'active' : ''}}" data-view="trend5" bindtap="switchFundView">5日</view>
      </view>
      </view>
      <view wx:if="{{fundView === 'main'}}" class="one-day-flow">
        <view class="one-day-menu" aria-disabled="true">
          <view class="one-day-menu-item">看点</view>
          <view class="one-day-menu-item">资讯</view>
          <view class="one-day-menu-item">盘口</view>
          <view class="one-day-menu-item selected" aria-current="true">资金<view class="one-day-menu-indicator"></view></view>
          <view class="one-day-menu-item">社区</view>
          <view class="one-day-menu-item">简况(F10)</view>
        </view>
        <view class="one-day-title">
          <view class="one-day-title-mark"></view>
          <text>主力流向({{unitLabel}})</text>
          <view class="one-day-title-arrow" aria-hidden="true"></view>
          <view class="one-day-info" role="button" aria-label="主力流向说明" bindtap="showDayFlowInfo"><view class="one-day-info-glyph" aria-hidden="true"><view class="one-day-info-dot"></view><view class="one-day-info-stem"></view></view></view>
          <view class="one-day-hk-link" aria-disabled="true"><text>查看港资动向</text><view class="one-day-hk-arrow"></view></view>
        </view>
        <view class="one-day-summary">
          <view wx:for="{{summary}}" wx:key="label" class="one-day-summary-item"><text>{{item.label}}</text><text class="one-day-total {{item.positive ? 'positive' : 'negative'}}">{{item.text}}</text></view>
        </view>
        <view class="one-day-chart">
          <view class="one-day-zero main"></view><view class="one-day-zero retail"></view>
          <view wx:for="{{dayBars}}" wx:key="label" class="one-day-column">
            <view class="one-day-bar {{item.positive ? 'positive' : 'negative'}}" style="left:{{item.center}}%;height:{{item.height}}%"></view>
            <text class="one-day-value {{item.positive ? 'positive' : 'negative'}}" style="left:{{item.center}}%;{{item.positive ? 'bottom' : 'top'}}:{{item.labelOffset}}%">{{item.text}}</text>
            <text class="one-day-name" style="left:{{item.center}}%">{{item.label}}</text>
          </view>
        </view>
      </view>
      <block wx:else>
        <view class="trend-summary"><text>{{trendMetricLabel}}</text><text class="trend-value {{trendMetricPositive ? 'up' : 'down'}}">{{trendMetricText}}</text></view>
        <view wx:if="{{trendHasData}}" class="trend-chart-wrap">
          <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
        </view>
        <view wx:else class="trend-empty">历史数据不足，暂时无法绘制该周期</view>
      </block>
    </view>
    <view class="card history-card">
      <view class="detail-title">30日主力趋势与 GS 信号</view>
      <view class="history-selected">{{historySelected.date}} <text class="history-selected-amount {{historySelected.main >= 0 ? 'up' : 'down'}}">{{historySelected.mainText}}</text> <text class="history-signal-label {{historySelected.gsClass}}">{{historySelected.gsLabel}}</text></view>
      <view class="history-navigation"><view wx:if="{{historyEarlierVisible}}" data-edge="earlier" bindtap="navigateHistory">‹ 更早</view><view wx:if="{{historyTodayVisible}}" class="history-today" data-edge="today" bindtap="navigateHistory">今天 ›</view></view>
      <scroll-view scroll-x scroll-with-animation scroll-left="{{historyScroll}}" bindscroll="onHistoryScroll" class="history-scroll">
        <view class="history-track">
          <view wx:for="{{historyBars}}" wx:key="tradeDate" data-index="{{item.index}}" bindtap="openHistoryDay" class="history-column {{historySelected.index === item.index ? 'selected' : ''}}">
            <view class="history-plot"><view class="history-zero"></view><view class="history-bar {{item.main >= 0 ? 'positive' : 'negative'}}" style="height:{{item.height}}px"></view></view>
            <view class="history-gs {{item.gsClass}}">{{item.gsBadge}}</view><view class="history-date">{{item.date}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="history-legend"><text class="history-gs signal-g signal-change">G</text> G信号 <text class="history-gs signal-g">g</text> G区间 <text class="history-gs signal-s signal-change">S</text> S信号 <text class="history-gs signal-s">s</text> S区间 <text class="history-gs signal-none"></text> 暂无</view>
      <view class="history-summary">{{historySummary}}</view>
    </view>
    <view wx:if="{{historyModal}}" class="history-mask" bindtap="closeHistoryDay" catchtouchmove="stopHistoryTap">
      <view class="history-sheet" catchtap="stopHistoryTap">
        <view class="history-handle"></view>
        <view class="history-date-heading"><text class="history-date-title">{{historySelected.tradeDate}}（周{{historySelected.weekday}}）</text><text class="history-signal-label {{historySelected.gsClass}}">{{historySelected.gsLabel}}</text></view>
        <view class="history-flow">
          <view class="chart-inline-title"><view class="chart-title-mark"></view><text>主力流向({{historySelected.unitLabel}})</text></view>
          <view class="summary-grid"><view wx:for="{{historySelected.flowSummary}}" wx:key="label" class="summary-item"><text>{{item.label}}</text><text class="summary-value {{item.positive ? 'up' : 'down'}}">{{item.text}}</text></view></view>
          <view class="flow-chart"><view class="zero-line"></view><view class="flow-columns"><view wx:for="{{historySelected.flowBars}}" wx:key="label" class="flow-column">
            <view wx:if="{{item.positive}}" class="flow-stack positive" style="bottom:50%"><text class="flow-value up">{{item.text}}</text><view class="flow-bar bar-up" style="height:{{item.height}}rpx"></view></view>
            <view wx:else class="flow-stack negative" style="top:50%"><view class="flow-bar bar-down" style="height:{{item.height}}rpx"></view><text class="flow-value down">{{item.text}}</text></view>
            <text class="flow-name">{{item.label}}</text>
          </view></view></view>
        </view>
        <view class="history-metrics"><view wx:for="{{historySelected.tierMetrics}}" wx:key="key" class="history-metric"><view>{{item.label}}</view><text class="{{item.positive ? 'up' : 'down'}}">{{item.text}}</text></view></view>
        <view class="history-actions"><button disabled="{{historySelected.index === 0}}" data-step="-1" bindtap="stepHistoryDay">← 前一日</button><button disabled="{{historySelected.index === historyBars.length - 1}}" data-step="1" bindtap="stepHistoryDay">后一日 →</button><button bindtap="closeHistoryDay">关闭</button></view>
      </view>
    </view>
    <view class="card detail-card">
      <view class="detail-title">资金明细</view>
      <view class="segment-control">
        <view class="segment {{detailView === 'core' ? 'active' : ''}}" data-view="core" bindtap="switchDetailView">主力资金</view>
        <view class="segment {{detailView === 'orders' ? 'active' : ''}}" data-view="orders" bindtap="switchDetailView">资金结构</view>
      </view>
      <view wx:if="{{detailView === 'core'}}" class="table core-table">
        <view class="tr th"><text>日期</text><text>主力净流入</text><text>暗盘</text><text>明盘</text></view>
        <view wx:for="{{rows}}" wx:key="tradeDate" class="tr detail-data-row" data-index="{{item.index}}" bindtap="openHistoryDay" hover-class="detail-row-hover"><view class="detail-date-cell"><view class="detail-date-link">{{item.displayDate}}</view><view wx:if="{{item.gsText !== '—'}}" class="detail-gs-tag {{item.gsClass}}">{{item.gsLabel}}</view></view><text class="{{item.main >= 0 ? 'up' : 'down'}}">{{item.mainText}}</text><text class="{{item.grey >= 0 ? 'up' : 'down'}}">{{item.greyText}}</text><text class="{{item.listed >= 0 ? 'up' : 'down'}}">{{item.listedText}}</text></view>
      </view>
      <view wx:else class="table orders-table">
        <view class="tr th"><text>日期</text><text>特大单</text><text>大单</text><text>中单</text><text>小单</text></view>
        <view wx:for="{{rows}}" wx:key="tradeDate" class="tr detail-data-row" data-index="{{item.index}}" bindtap="openHistoryDay" hover-class="detail-row-hover"><view class="detail-date-cell"><view class="detail-date-link">{{item.displayDate}}</view><view wx:if="{{item.gsText !== '—'}}" class="detail-gs-tag {{item.gsClass}}">{{item.gsLabel}}</view></view><text class="{{item.super_large >= 0 ? 'up' : 'down'}}">{{item.super_largeText}}</text><text class="{{item.large >= 0 ? 'up' : 'down'}}">{{item.largeText}}</text><text class="{{item.middle >= 0 ? 'up' : 'down'}}">{{item.middleText}}</text><text class="{{item.small >= 0 ? 'up' : 'down'}}">{{item.smallText}}</text></view>
      </view>
    </view>
    <view class="detail-pagination"><button disabled="{{detailPage <= 1}}" data-step="-1" bindtap="changeDetailPage">上一页</button><button disabled="{{detailPage >= detailPages}}" data-step="1" bindtap="changeDetailPage">下一页</button></view>
    <view class="disclaimer">数据和图表来自互联网，由AI生成，仅供参考，不构成投资建议</view>
    <canvas type="2d" id="sharePosterCanvas" class="share-poster-canvas"></canvas>
  </block>
</view>
