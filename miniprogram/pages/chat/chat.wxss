.page {
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}
.msgs {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}
.msg.mine {
  flex-direction: row-reverse;
}
.m-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.bubble {
  max-width: 480rpx;
  padding: 20rpx 26rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.4;
  margin: 0 18rpx;
  word-break: break-all;
}
.theirs .bubble {
  background: #fff;
  color: #333;
}
.mine .bubble {
  background: #ff2442;
  color: #fff;
}

.inputbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.input {
  flex: 1;
  height: 72rpx;
  background: #f3f3f3;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
}
.send-btn {
  margin-left: 20rpx;
  color: #ccc;
  font-size: 30rpx;
  padding: 0 16rpx;
}
.send-btn.active {
  color: #ff2442;
  font-weight: 600;
}
