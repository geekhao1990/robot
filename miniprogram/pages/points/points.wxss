page { background: #f7f7f7; }

.page {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  min-height: 100vh;
  padding: 28rpx 28rpx 70rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}

.balance-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  padding: 38rpx 36rpx 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff4964, #ff2442);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 32rpx rgba(255, 36, 66, .2);
}

.balance-label { font-size: 26rpx; opacity: .86; }
.balance-value { margin-top: 8rpx; font-size: 72rpx; line-height: 1.15; font-weight: 800; }
.balance-cash { margin-top: 6rpx; font-size: 24rpx; opacity: .78; }
.balance-actions { display: flex; align-items: center; width: 100%; margin-top: 30rpx; }
.balance-action {
  width: 210rpx;
  padding: 17rpx 0;
  text-align: center;
  font-size: 25rpx;
  background: rgba(255,255,255,.18);
  border: 1rpx solid rgba(255,255,255,.25);
  border-radius: 999rpx;
}
.balance-detail-link { margin-left: 28rpx; padding: 12rpx 4rpx; color: #fff; font-size: 24rpx; text-decoration: underline; text-underline-offset: 5rpx; opacity: .9; }

.task-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex-shrink: 0;
  width: 100%;
  margin-top: 24rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
}

.section-head { display: flex; align-items: flex-start; justify-content: space-between; width: 100%; }
.section-head > view:first-child { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.section-title { color: #222; font-size: 30rpx; font-weight: 700; }
.section-sub { margin-top: 8rpx; color: #999; font-size: 23rpx; }
.count { flex-shrink: 0; margin-left: 12rpx; color: #999; font-size: 25rpx; }
.count text { color: #ff2442; font-size: 38rpx; font-weight: 750; }
.reward-progress { position: relative; display: flex; align-items: center; width: 100%; height: 100rpx; margin-top: 26rpx; padding-right: 96rpx; box-sizing: border-box; }
.reward-track { position: absolute; left: 0; right: 84rpx; top: 35rpx; display: flex; align-items: stretch; height: 16rpx; overflow: hidden; background: #f1f1f1; border-radius: 999rpx; }
.progress-inner { height: 100%; background: linear-gradient(90deg, #ff6a7f, #ff2442); border-radius: inherit; transition: width .25s; }
.reward-goal { position: absolute; right: 0; top: 0; display: flex; flex-direction: column; align-items: center; width: 124rpx; text-align: center; }
.gift-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: #fff; font-size: 23rpx; font-weight: 750; line-height: 1; background: #ff2442; border: 7rpx solid #ffe3e7; border-radius: 50%; box-sizing: border-box; }
.reward-goal.reached .gift-icon { background: #ffb21d; border-color: #fff0cc; }
.goal-points { margin-top: 5rpx; color: #ff2442; font-size: 23rpx; font-weight: 750; }
.goal-label { color: #999; font-size: 18rpx; white-space: nowrap; transform: translateX(-4rpx); }
.task-tip { margin-top: 18rpx; color: #777; font-size: 23rpx; line-height: 1.5; }
.task-tip.done { color: #ff2442; }
.watch-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  color: #fff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1;
  background: #ff2442;
  border-radius: 999rpx;
}
.watch-btn::after { border: 0; }
.watch-btn.disabled { color: #aaa; background: #eee; }

.invite-card { display: flex; flex-direction: column; align-items: stretch; flex-shrink: 0; width: 100%; margin-top: 24rpx; padding: 30rpx; background: #fff; border-radius: 24rpx; box-sizing: border-box; }
.invite-total { flex-shrink: 0; color: #777; font-size: 23rpx; }
.invite-total text { margin: 0 5rpx; color: #ff2442; font-size: 34rpx; font-weight: 750; }
.invite-link-row { display: flex; align-items: center; width: 100%; margin-top: 24rpx; overflow: hidden; }
.invite-link { display: flex; flex-direction: column; justify-content: center; flex-grow: 1; flex-shrink: 1; flex-basis: 0; width: 0; min-width: 0; height: 72rpx; padding: 7rpx 13rpx; overflow: hidden; background: #f7f7f7; border: 2rpx solid #eee; border-radius: 12rpx; box-sizing: border-box; }
.link-label { width: 100%; overflow: hidden; color: #777; font-size: 19rpx; line-height: 25rpx; white-space: nowrap; text-overflow: ellipsis; }
.link-value { width: 100%; margin-top: 1rpx; overflow: hidden; color: #333; font-size: 16rpx; line-height: 22rpx; white-space: nowrap; text-overflow: ellipsis; }
.link-action-slot { display: flex; align-items: stretch; flex-grow: 0; flex-shrink: 0; flex-basis: 106rpx; width: 106rpx; height: 72rpx; margin-left: 8rpx; overflow: hidden; }
.link-action { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; min-height: 0; margin: 0; padding: 0; color: #fff; font-size: 18rpx; line-height: 1; text-align: center; background: #ff2442; border-radius: 12rpx; box-sizing: border-box; }
.link-action::after { border: 0; }
.invite-note { margin-top: 16rpx; color: #999; font-size: 21rpx; line-height: 1.55; }
.invite-summary { display: flex; align-items: stretch; width: 100%; margin-top: 28rpx; padding: 22rpx 0; background: #fff5f6; border-radius: 16rpx; }
.invite-summary view { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; text-align: center; }
.invite-summary text { display: block; color: #ff2442; font-size: 30rpx; font-weight: 750; }
.invite-summary label { display: block; margin-top: 6rpx; color: #999; font-size: 21rpx; }

.record-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1200; display: flex; align-items: flex-end; background: rgba(0,0,0,.45); }
.record-panel { width: 100%; max-height: 78vh; padding: 34rpx 30rpx calc(32rpx + env(safe-area-inset-bottom)); overflow-y: auto; background: #fff; border-radius: 30rpx 30rpx 0 0; box-sizing: border-box; }
.record-head { display: flex; align-items: flex-start; justify-content: space-between; }
.record-total { margin-top: 7rpx; color: #999; font-size: 21rpx; }
.record-close { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; color: #999; font-size: 46rpx; line-height: 1; }
.record-list { margin-top: 12rpx; }
.record { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 26rpx 0; border-bottom: 1rpx solid #f1f1f1; }
.record > view:first-child { display: flex; flex-grow: 1; flex-shrink: 1; flex-basis: 0; flex-direction: column; min-width: 0; }
.record:last-child { border-bottom: 0; }
.record-title { color: #333; font-size: 26rpx; }
.record-time { margin-top: 7rpx; color: #aaa; font-size: 21rpx; }
.record-delta { flex-shrink: 0; margin-left: 16rpx; color: #ff2442; font-size: 29rpx; font-weight: 700; }
.record-pager { display: flex; align-items: center; justify-content: center; gap: 22rpx; margin-top: 22rpx; }
.record-pager button { width: 132rpx; height: 58rpx; margin: 0; padding: 0; color: #555; font-size: 23rpx; line-height: 58rpx; background: #f5f5f5; border-radius: 999rpx; }
.record-pager button::after { border: 0; }
.record-pager button[disabled] { color: #bbb; background: #f8f8f8; }
.record-pager text { min-width: 90rpx; color: #777; font-size: 23rpx; text-align: center; }
.empty { display: flex; align-items: center; justify-content: center; width: 100%; padding: 44rpx 0 34rpx; color: #aaa; font-size: 25rpx; text-align: center; }
