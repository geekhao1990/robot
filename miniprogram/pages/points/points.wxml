<view class="page">
  <view class="balance-card">
    <view class="balance-label">我的积分</view>
    <view class="balance-value">{{balance}}</view>
    <view class="balance-cash">约 ¥{{cashValue}}</view>
    <view class="balance-actions">
      <view class="balance-action" bindtap="comingSoon">兑换会员</view>
      <view class="balance-action" bindtap="comingSoon">申请提现</view>
    </view>
  </view>

  <view class="task-card">
    <view class="section-head">
      <view>
        <view class="section-title">每日看广告赚积分</view>
        <view class="section-sub">今日已赚 {{todayEarned}} 积分</view>
      </view>
      <view class="count"><text>{{todayViews}}</text>/{{dailyLimit}}</view>
    </view>
    <view class="progress"><view class="progress-inner" style="width: {{progress}}%;"></view></view>
    <view class="task-tip" wx:if="{{remaining > 0}}">再看 {{remaining}} 次完成今日任务，完成后额外奖励 {{completionBonus}} 积分</view>
    <view class="task-tip done" wx:else>今日任务已完成，明天再来</view>
    <button class="watch-btn {{remaining <= 0 ? 'disabled' : ''}}" loading="{{watching}}" disabled="{{watching || remaining <= 0}}" bindtap="watchAd">
      {{remaining > 0 ? '看激励广告 +' + perAd + '积分' : '今日任务已完成'}}
    </button>
  </view>

  <view class="rule-card">
    <view class="section-title">积分规则</view>
    <view class="rules">
      <view class="rule"><view class="rule-num">+{{perAd}}</view><view class="rule-text">每次广告</view></view>
      <view class="rule-line"></view>
      <view class="rule"><view class="rule-num">{{dailyLimit}}次</view><view class="rule-text">每日上限</view></view>
      <view class="rule-line"></view>
      <view class="rule"><view class="rule-num">{{pointsPerYuan}}:1</view><view class="rule-text">积分兑元</view></view>
    </view>
  </view>

  <view class="record-card">
    <view class="section-title">积分明细</view>
    <view wx:if="{{transactions.length}}">
      <view class="record" wx:for="{{transactions}}" wx:key="id">
        <view><view class="record-title">{{item.title}}</view><view class="record-time">{{item.timeText}}</view></view>
        <view class="record-delta">{{item.deltaText}}</view>
      </view>
    </view>
    <view wx:else class="empty">还没有积分记录</view>
  </view>
</view>
