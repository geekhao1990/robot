<view class="page">
  <view class="balance-card">
    <view class="balance-label">我的积分</view>
    <view class="balance-value">{{balance}}</view>
    <view class="balance-cash">约 ¥{{cashValue}}</view>
    <view class="balance-actions">
      <view class="balance-action" bindtap="comingSoon">兑换会员</view>
      <view class="balance-action" bindtap="comingSoon">申请提现</view>
    </view>
  </view>

  <view class="task-card">
    <view class="section-head">
      <view>
        <view class="section-title">每日看广告赚积分</view>
        <view class="section-sub">今日已赚 {{todayEarned}} 积分</view>
      </view>
      <view class="count"><text>{{todayViews}}</text>/{{dailyLimit}}</view>
    </view>
    <view class="reward-progress">
      <view class="reward-track"><view class="progress-inner" style="width: {{progress}}%;"></view></view>
      <view class="reward-goal {{dailyDone ? 'reached' : ''}}">
        <view class="gift-icon">礼</view>
        <view class="goal-points">+{{completionBonus}}积分</view>
        <view class="goal-label">完成{{dailyLimit}}次奖励</view>
      </view>
    </view>
    <view class="task-tip" wx:if="{{remaining > 0}}">再看 {{remaining}} 次，自动领取上方完成奖励</view>
    <view class="task-tip done" wx:else>今日任务已完成，明天再来</view>
    <button class="watch-btn {{dailyDone ? 'disabled' : ''}}" loading="{{watching}}" disabled="{{watching || dailyDone}}" bindtap="watchAd">
      {{watchButtonText}}
    </button>
  </view>

  <view class="invite-card">
    <view class="section-head">
      <view><view class="section-title">邀请好友赚积分</view><view class="section-sub">每成功邀请1位新用户，奖励{{perInvite}}积分</view></view>
      <view class="invite-total">已邀请<text>{{invitedCount}}</text>人</view>
    </view>
    <view class="invite-link" bindtap="copyInviteLink">
      <view class="link-copy">
        <view class="link-label">我的专属拉新链接</view>
        <view class="link-value">{{inviteLink}}</view>
      </view>
      <view class="link-copy-btn">复制</view>
    </view>
    <view class="invite-note">好友通过此链接进入并首次注册，奖励将发放到你的账户。</view>
    <view class="invite-buttons">
      <button class="invite-btn invite-btn-light" bindtap="copyInviteLink" disabled="{{!inviteLink}}">复制拉新链接</button>
      <button class="invite-btn" open-type="share" disabled="{{!inviteCode}}">微信发送</button>
    </view>
    <view class="invite-summary">
      <view><text>{{invitePoints}}</text><label>本月拉新积分</label></view>
      <view><text>{{inviteRankText}}</text><label>我的排名</label></view>
    </view>
  </view>

  <view class="rank-card">
    <view class="prize-heading">本月前五名奖励</view>
    <view class="prize-grid">
      <view wx:for="{{prizes}}" wx:key="rank" class="prize-item prize-{{item.rank}}"><text>{{item.range}}</text>{{item.prize}}</view>
    </view>
    <view class="rank-head"><view><view class="section-title">{{inviteMonth}} 拉新积分榜</view><view class="section-sub">新用户首次注册并绑定邀请关系后计入</view></view></view>
    <view class="update-date">榜单将于 <text>{{nextUpdateDate}}</text> 更新并发放奖励</view>
    <view wx:if="{{ranking.length}}" class="ranking">
      <view class="rank-row" wx:for="{{ranking}}" wx:key="userId">
        <view class="rank-number rank-{{item.rank}}">{{item.rank}}</view>
        <image class="rank-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="rank-name">{{item.name}}</view>
        <view class="rank-score"><text>{{item.count}}人</text><label>{{item.points}}积分</label></view>
      </view>
    </view>
    <view wx:else class="empty">本月还没有人上榜，快去邀请第一位好友</view>
  </view>

  <view class="rule-card">
    <view class="section-title">积分规则</view>
    <view class="rules">
      <view class="rule"><view class="rule-num">+{{perAd}}</view><view class="rule-text">每次广告</view></view>
      <view class="rule-line"></view>
      <view class="rule"><view class="rule-num">{{dailyLimit}}次</view><view class="rule-text">每日上限</view></view>
      <view class="rule-line"></view>
      <view class="rule"><view class="rule-num">{{pointsPerYuan}}:1</view><view class="rule-text">积分兑元</view></view>
    </view>
  </view>

  <view class="record-card">
    <view class="section-title">积分明细</view>
    <view wx:if="{{transactions.length}}">
      <view class="record" wx:for="{{transactions}}" wx:key="id">
        <view><view class="record-title">{{item.title}}</view><view class="record-time">{{item.timeText}}</view></view>
        <view class="record-delta">{{item.deltaText}}</view>
      </view>
    </view>
    <view wx:else class="empty">还没有积分记录</view>
  </view>
</view>
