.page {
  min-height: 100vh;
  background: #fff;
}
.item {
  display: flex;
  align-items: center;
  padding: 22rpx 30rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  max-width: 420rpx;
}
.btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #fff;
  background: #ff2442;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
}
.btn.followed {
  background: #fff;
  color: #999;
  border: 1rpx solid #ddd;
}
