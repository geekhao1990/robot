<view class="page">
  <view class="logo-wrap">
    <view class="logo">小红书</view>
    <view class="slogan">标记我的生活</view>
  </view>

  <view class="form">
    <view class="avatar-pick">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatar}}" mode="aspectFill" />
        <view class="avatar-tip">点击选择头像</view>
      </button>
    </view>

    <view class="field">
      <text class="field-label">昵称</text>
      <input
        class="field-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{name}}"
        bindinput="onName"
        bindblur="onName"
      />
    </view>
  </view>

  <button class="submit" bindtap="onLogin">登录 / 注册</button>

  <view class="quick" bindtap="onQuickLogin">使用演示账号一键登录</view>

  <view class="agreement">
    登录即代表同意《用户协议》和《隐私政策》（演示用途）
  </view>
</view>
