<view class="page">
  <view class="wx-box">
    <view class="default-avatar">
      <view class="avatar-head"></view>
      <view class="avatar-body"></view>
    </view>
    <view class="wx-tip">{{loginTip}}</view>
  </view>

  <button class="wx-login-btn" bindtap="onWechatLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}">
    {{loginText}}
  </button>

  <view class="agreement">
    <checkbox-group class="agreement-row" bindchange="onAgreementChange">
      <checkbox class="agreement-checkbox" value="agree" checked="{{agreementAccepted}}" color="#07c160" />
      <view class="agreement-copy">
        我已阅读并同意
        <text class="agreement-link" catchtap="openUserAgreement">《用户服务协议》</text>
        和
        <text class="agreement-link" catchtap="openPrivacyPolicy">《隐私政策》</text>
      </view>
    </checkbox-group>
  </view>
</view>
