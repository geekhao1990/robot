<view class="page">
  <view class="logo-wrap">
    <view class="logo">NiuLai</view>
    <view class="slogan">交易是一个人的修行</view>
  </view>

  <view class="wx-box">
    <image class="wx-icon" src="/images/niulai-logo.png" mode="aspectFill" />
    <view class="wx-tip">{{loginTip}}</view>
  </view>

  <button class="wx-login-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}">
    {{loginText}}
  </button>

  <view class="agreement">
    登录即代表同意《用户协议》和《隐私政策》
  </view>
</view>
