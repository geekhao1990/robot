.page {
  min-height: 100vh;
  background: #fff;
  padding: 0 60rpx;
}
.logo-wrap {
  text-align: center;
  padding: 72rpx 0 40rpx;
}
.logo-image {
  display: block;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  object-fit: cover;
}
.logo {
  font-size: 60rpx;
  font-weight: 800;
  color: #ff2442;
}
.slogan {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.wx-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 52rpx;
}
.wx-icon {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #f3f3f3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
}
.wx-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
}
.wx-login-btn::after { border: none; }
.wx-logo {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.quick {
  text-align: center;
  color: #ff2442;
  font-size: 28rpx;
  margin-top: 40rpx;
}

.agreement {
  position: fixed;
  bottom: 60rpx;
  left: 60rpx;
  right: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
