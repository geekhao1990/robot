.page {
  min-height: 100vh;
  background: #fff;
  padding: 0 60rpx;
}
.logo-wrap {
  text-align: center;
  padding: 120rpx 0 60rpx;
}
.logo {
  font-size: 72rpx;
  font-weight: 800;
  color: #ff2442;
}
.slogan {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.wx-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 70rpx;
}
.wx-icon {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #f3f3f3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
}
.wx-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
}
.wx-login-btn::after { border: none; }
.wx-logo {
  margin-right: 12rpx;
  font-size: 36rpx;
}

.phone-consent {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  margin-top: 30rpx;
  padding: 42rpx 34rpx 32rpx;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,.07);
  box-sizing: border-box;
}
.phone-title { color: #222; font-size: 34rpx; font-weight: 750; text-align: center; }
.phone-desc { margin-top: 18rpx; color: #888; font-size: 25rpx; line-height: 1.65; text-align: center; }
.phone-allow, .phone-skip { display: flex; align-items: center; justify-content: center; width: 100%; height: 84rpx; margin: 28rpx 0 0; font-size: 28rpx; border-radius: 999rpx; }
.phone-allow { color: #fff; background: #07c160; }
.phone-skip { margin-top: 16rpx; color: #777; background: #f5f5f5; }
.phone-allow::after, .phone-skip::after { border: none; }

.quick {
  text-align: center;
  color: #ff2442;
  font-size: 28rpx;
  margin-top: 40rpx;
}

.agreement {
  position: fixed;
  bottom: 60rpx;
  left: 60rpx;
  right: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
