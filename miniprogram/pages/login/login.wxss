.page {
  min-height: 100vh;
  background: #fff;
  padding: 0 60rpx;
}
.wx-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  margin-bottom: 70rpx;
}
.default-avatar {
  position: relative;
  overflow: hidden;
  width: 150rpx;
  height: 150rpx;
  background: #f2f2f2;
  border-radius: 50%;
}
.avatar-head {
  position: absolute;
  top: 30rpx;
  left: 50%;
  width: 50rpx;
  height: 50rpx;
  background: #c8c8c8;
  border-radius: 50%;
  transform: translateX(-50%);
}
.avatar-body {
  position: absolute;
  left: 50%;
  bottom: -20rpx;
  width: 112rpx;
  height: 76rpx;
  background: #c8c8c8;
  border-radius: 58rpx 58rpx 0 0;
  transform: translateX(-50%);
}
.wx-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
}
.wx-login-btn::after { border: none; }
.quick {
  text-align: center;
  color: #ff2442;
  font-size: 28rpx;
  margin-top: 40rpx;
}

.agreement {
  position: fixed;
  bottom: 60rpx;
  left: 60rpx;
  right: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
