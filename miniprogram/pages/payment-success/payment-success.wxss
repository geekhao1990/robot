.page { min-height: 100vh; padding: 50rpx 30rpx 80rpx; background: #f5f5f5; box-sizing: border-box; }
.loading { padding-top: 220rpx; color: #999; font-size: 28rpx; text-align: center; }
.success-card { display: flex; flex-direction: column; align-items: center; }
.success-icon { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; color: #fff; font-size: 58rpx; font-weight: 700; background: #07c160; border-radius: 50%; }
.success-title { margin-top: 24rpx; color: #222; font-size: 38rpx; font-weight: 800; }
.success-expire { margin-top: 10rpx; color: #888; font-size: 25rpx; }
.gift-card { display: flex; flex-direction: column; align-items: center; width: 100%; margin-top: 38rpx; padding: 34rpx 30rpx; background: #fff; border-radius: 24rpx; box-sizing: border-box; }
.gift-title { color: #ff2442; font-size: 32rpx; font-weight: 800; text-align: center; }
.gift-subtitle { margin-top: 12rpx; color: #777; font-size: 24rpx; line-height: 1.6; text-align: center; }
.qr { width: 360rpx; height: 360rpx; margin-top: 24rpx; background: #f7f7f7; border-radius: 18rpx; }
.member-code { position: relative; width: 100%; margin-top: 24rpx; padding: 20rpx 22rpx; background: #f7f7f7; border-radius: 16rpx; box-sizing: border-box; }
.code-label { color: #999; font-size: 21rpx; }
.code-value { margin-top: 7rpx; padding-right: 120rpx; color: #333; font-size: 24rpx; word-break: break-all; }
.code-copy { position: absolute; top: 50%; right: 22rpx; color: #ff2442; font-size: 24rpx; transform: translateY(-50%); }
.done-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 80rpx; margin: 34rpx 0 0; padding: 0; color: #fff; font-size: 28rpx; line-height: normal; background: #ff2442; border-radius: 999rpx; }
.done-button::after { border: 0; }
