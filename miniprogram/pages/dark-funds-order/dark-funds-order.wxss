.page { min-height: 100vh; padding: 28rpx 24rpx 60rpx; background: #f6f6f6; }
.empty { padding-top: 220rpx; color: #999; font-size: 26rpx; text-align: center; }
.note { padding: 34rpx 30rpx; background: #fff; border-radius: 22rpx; }
.author-row { display: flex; align-items: center; }
.author-avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-right: 18rpx; color: #fff; font-size: 28rpx; font-weight: 800; background: #ff2442; border-radius: 50%; }
.author-name { color: #333; font-size: 26rpx; font-weight: 700; }
.publish-time { margin-top: 5rpx; color: #aaa; font-size: 20rpx; }
.note-title { margin-top: 38rpx; color: #222; font-size: 38rpx; font-weight: 800; line-height: 1.35; }
.snapshot-image { display: block; width: 100%; margin-top: 28rpx; border-radius: 16rpx; background: #f2f2f2; }
.note-content { margin-top: 28rpx; color: #333; font-size: 28rpx; line-height: 1.9; white-space: pre-line; }
.note-meta { margin-top: 42rpx; padding-top: 24rpx; color: #999; font-size: 21rpx; line-height: 1.8; border-top: 1rpx solid #eee; overflow-wrap: anywhere; }
.disclaimer { margin-top: 26rpx; color: #999; font-size: 22rpx; line-height: 1.7; }
