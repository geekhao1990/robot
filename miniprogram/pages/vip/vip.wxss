.page {
  min-height: 100vh;
  background: #2b2b35;
  padding: 0 30rpx 60rpx;
}

.header {
  text-align: center;
  padding: 50rpx 0 40rpx;
}
.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid #f5d18b;
}
.h-name {
  color: #f5d9a8;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 18rpx;
}
.h-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #5a3d0a;
  background: linear-gradient(90deg, #f7dca0, #e9b765);
  border-radius: 999rpx;
  vertical-align: middle;
}
.h-status {
  color: #b9a98a;
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 套餐对比 */
.plans {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}
.plan {
  flex: 1;
  position: relative;
  background: #3a3a45;
  border: 2rpx solid #4a4a55;
  border-radius: 20rpx;
  padding: 36rpx 22rpx 26rpx;
}
.plan-year {
  background: linear-gradient(160deg, #4a3f2e, #3a3a45);
  border-color: #f5d18b;
}
.plan-badge {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #f5d18b;
  color: #5a3d0a;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.plan-name {
  color: #f5d9a8;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.plan-price {
  color: #f5d18b;
  font-size: 52rpx;
  font-weight: 800;
  margin-top: 12rpx;
  text-align: center;
}
.plan-price .cur { font-size: 28rpx; }
.plan-price .unit { font-size: 24rpx; color: #b9a98a; font-weight: 400; }
.plan-features {
  margin-top: 22rpx;
}
.pf-item {
  display: flex;
  align-items: flex-start;
  color: #ddd;
  font-size: 23rpx;
  line-height: 1.5;
  margin-bottom: 14rpx;
}
.pf-item .dot {
  color: #f5d18b;
  margin-right: 10rpx;
}

/* 权益对比表 */
.compare {
  background: #34343f;
  border-radius: 20rpx;
  padding: 10rpx 26rpx;
  margin-top: 40rpx;
}
.cmp-head, .cmp-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}
.cmp-row { border-top: 2rpx solid #40404b; }
.cmp-head {
  color: #f5d9a8;
  font-weight: 700;
  font-size: 26rpx;
}
.cmp-c1 { flex: 1; color: #ddd; font-size: 26rpx; }
.cmp-head .cmp-c1 { color: #f5d9a8; }
.cmp-c {
  width: 110rpx;
  text-align: center;
  font-size: 26rpx;
  color: #b9a98a;
}
.cmp-c.yes { color: #f5d18b; font-weight: 700; }
.cmp-c.no { color: #6c6c78; }

/* 联系开通 */
.footer {
  margin-top: 50rpx;
  text-align: center;
}
.contact-btn {
  background: linear-gradient(90deg, #f7dca0, #e9b765);
  color: #5a3d0a;
  font-size: 32rpx;
  font-weight: 700;
  padding: 26rpx 0;
  border-radius: 999rpx;
}
.tip {
  color: #777;
  font-size: 22rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}
