<view class="page">
  <!-- 头部 -->
  <view class="header">
    <image class="avatar" src="{{user.avatar}}" mode="aspectFill" wx:if="{{user}}" />
    <view class="h-name">{{user ? user.name : '未登录'}}<text wx:if="{{vipActive}}" class="h-badge">VIP</text></view>
    <view class="h-status">{{vipStatusText}}</view>
  </view>

  <!-- 套餐对比 -->
  <view class="plans">
    <view wx:for="{{plans}}" wx:key="id" class="plan {{item.id === 'year' ? 'plan-year' : ''}}">
      <view wx:if="{{item.badge}}" class="plan-badge">{{item.badge}}</view>
      <view class="plan-name">{{item.name}}</view>
      <view class="plan-price"><text class="cur">¥</text>{{item.price}}<text class="unit">/{{item.unit}}</text></view>
      <view class="plan-features">
        <view wx:for="{{item.features}}" wx:for-item="f" wx:key="*this" class="pf-item">
          <text class="dot">✓</text><text>{{f}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 权益对比表 -->
  <view class="compare">
    <view class="cmp-head">
      <text class="cmp-c1">权益对比</text>
      <text class="cmp-c">月卡</text>
      <text class="cmp-c">年卡</text>
    </view>
    <view wx:for="{{compare}}" wx:key="label" class="cmp-row">
      <text class="cmp-c1">{{item.label}}</text>
      <text class="cmp-c {{item.month ? 'yes' : 'no'}}">{{item.month ? '✓' : '—'}}</text>
      <text class="cmp-c {{item.year ? 'yes' : 'no'}}">{{item.year ? '✓' : '—'}}</text>
    </view>
  </view>

  <!-- 联系开通 -->
  <view class="footer">
    <view wx:if="{{user}}" class="member-code" bindtap="copyMemberCode">
      <view class="member-code-label">我的会员编号</view>
      <view class="member-code-value">{{memberCode}}</view>
      <view class="member-code-copy">点击复制</view>
    </view>
    <view class="contact-btn" bindtap="onContact">{{user ? '添加企业微信' : '登录后开通会员'}}</view>
    <view class="tip">添加企业微信后发送会员编号，管理员将在后台手动开通一个月会员。</view>
  </view>
</view>
