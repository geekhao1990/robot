.page {
  min-height: 100vh;
  background: #f5f5f5;
}
.hero {
  background: #fff;
  padding: 40rpx 30rpx 30rpx;
}
.row {
  display: flex;
  align-items: center;
}
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-right: 40rpx;
}
.stats {
  flex: 1;
  display: flex;
  justify-content: space-around;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat .num {
  font-size: 36rpx;
  font-weight: 700;
}
.stat .label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.name {
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 30rpx;
}
.desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
}
.follow-btn {
  margin-top: 28rpx;
  background: #ff2442;
  color: #fff;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.follow-btn.followed {
  background: #f3f3f3;
  color: #999;
}

.tabbar {
  display: flex;
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx 30rpx;
}
.tab.active {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.list {
  padding: 12rpx;
}
.waterfall {
  display: flex;
  gap: 16rpx;
}
.column {
  flex: 1;
  width: 0;
}
