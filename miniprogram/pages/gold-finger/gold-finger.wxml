<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-inner" style="height: {{navBarHeight}}px;">
      <view class="back" bindtap="goBack">‹</view>
      <view class="nav-title">金手指</view>
      <view class="nav-vip">VIP</view>
    </view>
  </view>

  <scroll-view class="body" scroll-y style="padding-top: {{headerHeight}}px;">
    <view wx:if="{{loading}}" class="state-box">
      <view class="loading-dot"></view>
      <view>正在加载会员数据...</view>
    </view>

    <view wx:elif="{{!record}}" class="state-box empty">
      <view class="empty-icon">—</view>
      <view class="empty-title">今日数据正在更新</view>
      <view class="empty-sub">请稍后再来查看</view>
    </view>

    <block wx:else>
      <view class="history-card">
        <view class="history-title">点金历史</view>
        <view class="history-head history-grid">
          <text>日期</text><text>阳谱</text><text>阴谱</text><text>点金</text><text>中期趋势</text><text>仓位</text>
        </view>
        <view wx:for="{{records}}" wx:key="date" class="history-row history-grid">
          <text class="history-date">{{item.date}}</text>
          <text class="history-yang {{item.yangClass}}">{{item.yang}}%</text>
          <text class="history-yin {{item.yinClass}}">{{item.yin}}%</text>
          <text class="history-finger {{item.finger}}">{{item.fingerIcon}}</text>
          <text class="history-trend {{item.trend}}">{{item.trendText}}</text>
          <text class="history-position">{{item.position}}%</text>
        </view>
        <view wx:if="{{hasMoreHistory || historyExpanded}}" class="history-more">
          <view wx:if="{{historyLoading}}">加载中...</view>
          <view wx:elif="{{!historyExpanded}}" bindtap="loadMoreHistory">查看更多历史</view>
          <view wx:elif="{{hasMoreHistory}}" bindtap="loadMoreHistory">加载上一个月</view>
          <view wx:else class="history-end">已显示全部历史</view>
        </view>
      </view>

      <swiper wx:if="{{banners.length}}" class="banner-swiper" indicator-dots="{{banners.length > 1}}" autoplay="{{banners.length > 1}}" interval="4000" duration="450" circular="{{banners.length > 1}}">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <image class="banner-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.noteId}}" bindtap="goBannerNote" />
        </swiper-item>
      </swiper>
      <view class="disclaimer">数据仅供会员参考，不构成任何投资建议</view>
    </block>
  </scroll-view>
</view>
