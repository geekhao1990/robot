.page { min-height: 100vh; color: #241b13; background: #f6f3ee; }
.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: rgba(255,255,255,.96); border-bottom: 1rpx solid rgba(96,68,32,.08); box-sizing: content-box; }
.nav-inner { position: relative; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; }
.back { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; color: #222; font-size: 58rpx; font-weight: 300; }
.nav-title { font-size: 32rpx; font-weight: 800; }
.nav-vip { position: absolute; right: 28rpx; padding: 5rpx 13rpx; color: #765015; font-size: 18rpx; font-weight: 800; letter-spacing: 1rpx; background: linear-gradient(135deg,#fff0b8,#d8ad54); border-radius: 999rpx; }
.body { height: 100vh; padding-left: 28rpx; padding-right: 28rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.state-box { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; color: #9a8f82; font-size: 27rpx; }
.loading-dot { width: 38rpx; height: 38rpx; margin-bottom: 24rpx; border: 5rpx solid #eadfcf; border-top-color: #b98935; border-radius: 50%; animation: rotate .8s linear infinite; }
@keyframes rotate { to { transform: rotate(360deg); } }
.empty-icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; color: #b98935; font-size: 46rpx; background: #fff; border-radius: 50%; }
.empty-title { margin-top: 26rpx; color: #43372a; font-size: 32rpx; font-weight: 700; }
.empty-sub { margin-top: 10rpx; }
.hero { margin-top: 28rpx; padding: 34rpx; color: #fff; background: linear-gradient(145deg,#241c15,#49351f); border-radius: 28rpx; box-shadow: 0 18rpx 45rpx rgba(54,38,22,.18); }
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.eyebrow { color: rgba(255,255,255,.54); font-size: 21rpx; letter-spacing: 3rpx; }
.date { margin-top: 8rpx; font-size: 29rpx; font-weight: 650; }
.updated { padding: 6rpx 14rpx; color: #f2dca8; font-size: 20rpx; background: rgba(241,210,144,.12); border: 1rpx solid rgba(241,210,144,.25); border-radius: 999rpx; }
.finger { margin-top: 52rpx; font-family: serif; font-size: 76rpx; font-weight: 900; letter-spacing: 10rpx; text-align: center; }
.finger.gold { color: #f4cf78; text-shadow: 0 5rpx 20rpx rgba(244,207,120,.22); }
.finger.silver { color: #e9edf3; text-shadow: 0 5rpx 20rpx rgba(220,228,240,.2); }
.finger-caption { margin-top: 10rpx; color: rgba(255,255,255,.48); font-size: 22rpx; letter-spacing: 4rpx; text-align: center; }
.spectrum-card,.position-card { margin-top: 24rpx; padding: 30rpx; background: #fff; border: 1rpx solid rgba(96,68,32,.06); border-radius: 24rpx; box-shadow: 0 8rpx 26rpx rgba(80,58,32,.05); }
.section-title { color: #4b3c2c; font-size: 29rpx; font-weight: 800; }
.spectrum-values { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 24rpx; }
.spectrum-value { display: flex; align-items: baseline; gap: 10rpx; }
.spectrum-value .value { font-size: 58rpx; font-weight: 850; line-height: 1; }
.spectrum-value .unit { color: #998b7a; font-size: 21rpx; }
.spectrum-value.yin .value { color: #38445d; }
.spectrum-value.yang .value { color: #c44c38; }
.sum-mark { padding-bottom: 6rpx; color: #b0a493; font-size: 19rpx; }
.spectrum-bar { display: flex; width: 100%; height: 18rpx; margin-top: 25rpx; overflow: hidden; background: #eee; border-radius: 999rpx; }
.yin-bar { background: linear-gradient(90deg,#1f293b,#53617c); }
.yang-bar { background: linear-gradient(90deg,#df765d,#bd3f31); }
.signal-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.signal-card { flex: 1; min-width: 0; padding: 28rpx; background: #fff; border: 1rpx solid rgba(96,68,32,.06); border-radius: 24rpx; box-shadow: 0 8rpx 26rpx rgba(80,58,32,.05); }
.signal-label { color: #9a8d7d; font-size: 22rpx; }
.trend,.position { margin-top: 18rpx; font-size: 39rpx; font-weight: 850; }
.trend.up { color: #d34936; }
.trend.down { color: #168c62; }
.trend-icon { margin-right: 10rpx; }
.position { color: #3f3327; }
.position text { font-size: 50rpx; }
.position-head,.position-labels { display: flex; align-items: center; justify-content: space-between; }
.position-head { color: #4b3c2c; font-size: 25rpx; font-weight: 750; }
.position-track { height: 16rpx; margin-top: 24rpx; overflow: hidden; background: #eee8df; border-radius: 999rpx; }
.position-fill { height: 100%; background: linear-gradient(90deg,#dcbf78,#a57424); border-radius: 999rpx; }
.position-labels { margin-top: 12rpx; color: #b0a493; font-size: 19rpx; }
.history-card { margin: 20rpx -28rpx 0; padding: 32rpx 28rpx 0; background: #fff; border-top: 1rpx solid #eee; border-bottom: 1rpx solid #eee; }
.history-title { padding-left: 22rpx; color: #242424; font-size: 36rpx; font-weight: 850; border-left: 9rpx solid #ff2442; }
.history-grid { display: flex; align-items: center; width: 100%; }
.history-grid > * { flex: .72 1 0; min-width: 0; text-align: center; }
.history-grid > *:first-child { flex: 1.55 1 0; text-align: left; }
.history-grid > *:nth-child(4) { flex: .68 1 0; }
.history-grid > *:nth-child(5) { flex: 1.05 1 0; }
.history-grid > *:nth-child(6) { flex: .65 1 0; }
.history-head { margin-top: 28rpx; padding: 24rpx 0; color: #999; font-size: 20rpx; border-top: 1rpx solid #f0f0f0; border-bottom: 1rpx solid #ededed; }
.history-row { min-height: 104rpx; color: #222; font-size: 23rpx; border-bottom: 1rpx solid #ededed; }
.history-date { font-size: 22rpx; font-variant-numeric: tabular-nums; }
.history-yang,.history-yin { color: #222; font-weight: 650; }
.history-yang.strong { color: #e53935; }
.history-yin.strong { color: #11a52b; }
.history-finger-cell { display: flex; align-items: center; justify-content: center; }
.history-finger { display: block; width: 42rpx; height: 52rpx; }
.history-trend { font-weight: 700; }
.history-trend.up { color: #e53935; }
.history-trend.down { color: #11a52b; }
.history-position { color: #222; font-weight: 650; }
.history-more { display: flex; align-items: center; justify-content: center; min-height: 104rpx; color: #999; font-size: 28rpx; }
.history-more view { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 92rpx; }
.history-end { color: #bbb3aa; }
.banner-swiper { width: 100%; height: 250rpx; margin-top: 28rpx; margin-bottom: 8rpx; overflow: hidden; background: #eee; border-radius: 20rpx; }
.banner-image { display: block; width: 100%; height: 100%; }
.disclaimer { padding: 24rpx 0 50rpx; color: #aaa095; font-size: 20rpx; text-align: center; }
