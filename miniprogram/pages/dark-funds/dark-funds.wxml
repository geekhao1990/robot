<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'query' ? 'active' : ''}}" data-tab="query" bindtap="switchTab">查暗盘</view>
    <view class="tab {{tab === 'ranking' ? 'active' : ''}}" data-tab="ranking" bindtap="switchTab">今日暗盘榜</view>
    <view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">
      <text>订单列表</text><text wx:if="{{historyBadge}}" class="history-badge">{{historyBadge}}</text>
    </view>
  </view>

  <view wx:if="{{tab === 'ranking'}}" class="ranking-page">
    <view wx:if="{{rankingLoading}}" class="ranking-loading">正在加载收盘暗盘榜…</view>
    <view wx:elif="{{rankingEmpty}}" class="ranking-empty">今日暗盘榜16点后更新</view>
    <block wx:else>
      <view class="ranking-head"><view><text class="ranking-title">{{ranking.title || '收盘暗盘榜'}}</text><text wx:if="{{ranking.updateHint}}" class="ranking-update-hint">{{ranking.updateHint}}</text></view><text class="ranking-source">{{ranking.previewMock ? '效果预览' : '同花顺热榜100只'}}</text></view>
      <view class="ranking-section">
        <view class="ranking-section-title inflow">暗盘流入前五</view>
        <view wx:for="{{ranking.inflow}}" wx:key="stockCode" class="ranking-row" data-code="{{item.stockCode}}" data-name="{{item.stockName}}" data-initials="{{item.stockInitials}}" bindtap="openRankingResult">
          <text class="ranking-number">{{index + 1}}</text>
          <view class="ranking-stock"><text>{{item.stockDisplayName}}</text><text>{{item.marketStockCode}}</text></view>
          <text class="ranking-value up">{{item.greyText}}</text>
          <view class="ranking-share" data-code="{{item.stockCode}}" data-name="{{item.stockName}}" data-initials="{{item.stockInitials}}" catchtap="shareRankingResult"><view class="ranking-share-icon"></view><text>生成分享图</text></view>
        </view>
        <view wx:if="{{!ranking.inflow.length}}" class="ranking-list-empty">暂无净流入股票</view>
      </view>
      <view class="ranking-section">
        <view class="ranking-section-title outflow">暗盘流出前五</view>
        <view wx:for="{{ranking.outflow}}" wx:key="stockCode" class="ranking-row" data-code="{{item.stockCode}}" data-name="{{item.stockName}}" data-initials="{{item.stockInitials}}" bindtap="openRankingResult">
          <text class="ranking-number">{{index + 1}}</text>
          <view class="ranking-stock"><text>{{item.stockDisplayName}}</text><text>{{item.marketStockCode}}</text></view>
          <text class="ranking-value down">{{item.greyText}}</text>
          <view class="ranking-share" data-code="{{item.stockCode}}" data-name="{{item.stockName}}" data-initials="{{item.stockInitials}}" catchtap="shareRankingResult"><view class="ranking-share-icon"></view><text>生成分享图</text></view>
        </view>
        <view wx:if="{{!ranking.outflow.length}}" class="ranking-list-empty">暂无净流出股票</view>
      </view>
      <view class="ranking-tip">仅统计收盘暗盘数据；榜单显示最近一次已生成的交易日结果</view>
    </block>
  </view>

  <view wx:if="{{tab === 'query'}}" class="query-page">
    <view class="query-card">
      <view class="code-box">
        <input class="code-input" type="number" maxlength="6" value="{{stockCode}}" placeholder="请输入6位代码" bindinput="onCodeInput" focus />
      </view>
      <view wx:if="{{stockLookupLoading || stockSuggestion || stockLookupError}}" class="stock-dropdown">
        <view wx:if="{{stockLookupLoading}}" class="stock-dropdown-tip">正在查询股票名称…</view>
        <view wx:elif="{{stockSuggestion}}" class="stock-option">
          <text class="stock-option-code">{{stockSuggestion.stockCode}}</text>
          <text class="stock-option-name {{stockSuggestion.matched ? '' : 'unknown'}}">{{stockSuggestion.stockDisplayName || '新股或未收录，可继续提交'}}</text>
        </view>
        <view wx:else class="stock-dropdown-error">{{stockLookupError}}</view>
      </view>
      <view class="query-actions">
        <button wx:if="{{decisionPioneerEnabled}}" class="query-button query-button-live" bindtap="prepareIntradayQuery" loading="{{querying}}" disabled="{{dateLoading || querying}}">决策拼单</button>
        <button class="query-button query-button-close" bindtap="prepareCloseQuery" loading="{{querying}}" disabled="{{dateLoading || querying}}">盘后查询</button>
      </view>
      <view class="query-benefits-row">
        <view class="quota-summary">
          <view wx:if="{{closeMonthlyActive}}" class="remaining-tip">盘后包月：<text>无限查询</text><text wx:if="{{closeMonthlyExpiryText}}" class="quota-expiry">（有效至 {{closeMonthlyExpiryText}}）</text></view>
          <view class="remaining-tip">剩余次数：<text>{{remaining}}</text></view>
          <view class="quota-details">
            <view><text>30天内到期</text><text>{{expiringRemaining}} 次<text wx:if="{{quotaExpiryText}}" class="quota-expiry">（有效至 {{quotaExpiryText}}）</text></text></view>
            <view><text>长期有效</text><text>{{permanentRemaining}} 次</text></view>
          </view>
        </view>
        <view class="recharge-actions">
          <view class="recharge-button" bindtap="openTopupModal">
            <view class="recharge-icon">充</view>
            <view class="recharge-copy"><view class="recharge-title">充值暗盘次数</view><view class="recharge-description"><text>暗盘查询低至3毛</text><text>次数长期有效</text></view></view>
          </view>
        </view>
      </view>
      <view wx:if="{{queryAdUnitId && !queryAdLoadFailed}}" class="query-ad-slot">
        <ad unit-id="{{queryAdUnitId}}" binderror="onQueryAdError" />
      </view>
    </view>
  </view>

  <view wx:if="{{tab === 'history'}}" class="history-page">
    <view class="history-toolbar"><view>查询记录</view><view class="history-refresh {{historyLoading ? 'disabled' : ''}}" bindtap="refreshOrders">{{historyLoading ? '刷新中…' : '手动刷新'}}</view></view>
    <view wx:if="{{historyLoading}}" class="empty">正在加载...</view>
    <view wx:elif="{{!orders.length}}" class="empty">暂无订单</view>
    <view wx:else class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openOrder">
        <view class="order-main">
          <view class="order-stock"><text wx:if="{{item.stockDisplayName}}" class="order-name">{{item.stockDisplayName}}</text><text class="order-code">{{item.marketStockCode}}</text></view>
          <view class="order-meta"><view class="order-type">{{item.queryTypeText}}</view><view class="order-query-time">查询时间：{{item.queryTimeText}}</view></view>
        </view>
        <view class="order-side {{item.ready ? 'ready' : 'pending'}} {{item.failed ? 'failed' : ''}}"><text>{{item.statusText}}</text><text wx:if="{{item.ready}}" class="arrow">›</text></view>
      </view>
    </view>
    <view wx:if="{{!historyLoading && orders.length}}" class="history-pagination">
      <view class="history-page-button {{historyPage <= 1 ? 'disabled' : ''}}" data-page="{{historyPage - 1}}" bindtap="changeHistoryPage">上一页</view>
      <view class="history-page-number">第 {{historyPage}} / {{historyTotalPages}} 页</view>
      <view class="history-page-button {{historyPage >= historyTotalPages ? 'disabled' : ''}}" data-page="{{historyPage + 1}}" bindtap="changeHistoryPage">下一页</view>
    </view>
    <view wx:if="{{!historyLoading && orders.length && historyAdUnitId && !historyAdLoadFailed}}" class="history-ad-slot">
      <ad unit-id="{{historyAdUnitId}}" binderror="onHistoryAdError" />
    </view>
  </view>
</view>
<view wx:if="{{topupVisible}}" class="topup-mask" bindtap="closeTopupModal">
  <view class="topup-sheet" catchtap="noop">
    <view class="topup-handle"></view>
    <view class="topup-title">充值暗盘次数</view>
    <view class="topup-subtitle">充值次数长期有效，可用于决策拼单和盘后查询</view>
    <view class="topup-skus">
      <view wx:for="{{topupSkus}}" wx:key="sku" class="topup-sku {{selectedTopupSku === item.sku ? 'selected' : ''}}" data-sku="{{item.sku}}" bindtap="selectTopupSku">
        <view><text class="topup-times">{{item.times}}次</text><text class="topup-unit">{{item.unitPrice}}</text></view>
        <text class="topup-price">{{item.price}}</text>
        <view wx:if="{{selectedTopupSku === item.sku}}" class="topup-check">✓</view>
      </view>
    </view>
    <button class="topup-pay" bindtap="purchaseTopup" loading="{{purchasing}}" disabled="{{purchasing}}">立即支付</button>
    <view class="topup-contact" bindtap="openTopupEnterpriseWechat">更多套餐请咨询企业微信 ›</view>
  </view>
</view>
<view wx:if="{{serviceQrVisible}}" class="contact-qr-mask" bindtap="closeServiceQr">
  <view class="contact-qr-sheet" catchtap="noop">
    <view class="contact-qr-handle"></view>
    <view class="contact-qr-title">{{serviceQrTitle}}</view>
    <view class="contact-qr-description">{{serviceQrDescription}}</view>
    <image class="contact-qr-image" src="{{serviceQrImage}}" mode="widthFix" bindtap="previewServiceQr" show-menu-by-longpress />
    <view class="contact-qr-tip">点击查看大图，长按可识别或保存</view>
  </view>
</view>
