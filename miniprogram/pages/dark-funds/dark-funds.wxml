<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'query' ? 'active' : ''}}" data-tab="query" bindtap="switchTab">六位神奇数字</view>
    <view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">
      <text>历史订单</text><text wx:if="{{historyBadge}}" class="history-badge">{{historyBadge}}</text>
    </view>
  </view>

  <view wx:if="{{tab === 'query'}}" class="query-page">
    <view class="query-card">
      <view class="code-box">
        <input class="code-input" type="number" maxlength="6" value="{{stockCode}}" bindinput="onCodeInput" focus />
      </view>
      <view class="trade-date">查询日期：{{compactTradeDate || '获取中...'}}</view>
      <view class="query-actions">
        <button class="query-button" bindtap="prepareQuery" loading="{{querying}}" disabled="{{dateLoading || querying}}">查询</button>
        <button class="contact-button" open-type="contact">联系客服</button>
      </view>
      <view class="remaining-tip">剩余次数：{{remaining}}</view>
      <view wx:if="{{waitingText}}" class="waiting-tip">{{waitingText}}</view>
    </view>
  </view>

  <view wx:if="{{tab === 'history'}}" class="history-page">
    <view wx:if="{{historyLoading}}" class="empty">正在加载...</view>
    <view wx:elif="{{!orders.length}}" class="empty">暂无历史订单</view>
    <view wx:else class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="openOrder">
        <view class="order-main">
          <view class="order-code">{{item.stockCode}}</view>
          <view class="order-date">{{item.compactTradeDate}} 暗盘数据</view>
        </view>
        <view class="order-side {{item.ready ? 'ready' : 'pending'}}"><text>{{item.statusText}}</text><text wx:if="{{item.ready}}" class="arrow">›</text></view>
      </view>
    </view>
  </view>
</view>
