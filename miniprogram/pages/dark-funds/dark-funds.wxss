.page { min-height: 100vh; background: #f6f6f6; }
.tabs { position: sticky; top: 0; z-index: 10; display: flex; height: 92rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; color: #777; font-size: 28rpx; }
.tab.active { color: #222; font-weight: 700; }
.tab.active::after { position: absolute; bottom: 0; left: 50%; width: 52rpx; height: 6rpx; content: ''; background: #ff2442; border-radius: 999rpx; transform: translateX(-50%); }
.history-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 30rpx; height: 30rpx; margin-left: 8rpx; padding: 0 7rpx; color: #fff; font-size: 18rpx; font-weight: 700; line-height: 1; background: #ff2442; border-radius: 999rpx; box-sizing: border-box; }
.query-page { padding: 30rpx 24rpx; }
.query-card { padding: 48rpx 32rpx 38rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.04); }
.code-box { padding: 0 24rpx; background: #f7f7f7; border: 2rpx solid transparent; border-radius: 16rpx; }
.code-input { height: 96rpx; color: #222; font-size: 34rpx; font-weight: 700; letter-spacing: 6rpx; text-align: center; }
.stock-dropdown { margin-top: 10rpx; overflow: hidden; background: #fff; border: 1rpx solid #eee; border-radius: 14rpx; box-shadow: 0 10rpx 28rpx rgba(0,0,0,.08); }
.stock-option, .stock-dropdown-tip, .stock-dropdown-error { display: flex; align-items: center; min-height: 76rpx; padding: 0 24rpx; font-size: 25rpx; }
.stock-option { justify-content: space-between; color: #222; }
.stock-option-code { font-weight: 750; letter-spacing: 2rpx; }
.stock-option-name { color: #555; font-weight: 650; }
.stock-option-name.unknown { color: #999; font-size: 22rpx; font-weight: 500; }
.stock-dropdown-tip { justify-content: center; color: #999; }
.stock-dropdown-error { justify-content: center; color: #ff2442; }
.query-actions { display: flex; align-items: center; gap: 18rpx; margin-top: 40rpx; }
.query-button { display: flex; align-items: center; justify-content: center; height: 88rpx; margin: 0; padding: 0 16rpx; font-size: 25rpx; font-weight: 700; line-height: normal; border-radius: 999rpx; }
.query-button { flex: 1; color: #fff; background: #ff2442; }
.query-button-close { color: #ff2442; background: #fff5f7; border: 2rpx solid #ff2442; }
.query-button::after { border: none; }
.query-button[disabled] { color: #fff; background: #ff9aaa; }
.query-benefits-row { display: flex; align-items: stretch; gap: 16rpx; margin-top: 24rpx; }
.recharge-actions { display: flex; flex: 0 0 calc(50% - 8rpx); min-width: 0; }
.recharge-button { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: center; padding: 22rpx 16rpx; background: linear-gradient(115deg,#fff3e8,#fff9f2); border: 1rpx solid #ffd6ad; border-radius: 18rpx; box-sizing: border-box; }
.recharge-icon { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 14rpx; color: #fff; font-size: 28rpx; font-weight: 800; background: linear-gradient(135deg,#ff8a3d,#f04b23); border-radius: 18rpx; }
.recharge-copy { min-width: 0; }
.recharge-title { color: #b94c08; font-size: 27rpx; font-weight: 800; white-space: nowrap; }
.recharge-description { margin-top: 7rpx; color: #a87958; font-size: 21rpx; line-height: 1.45; }
.recharge-description text { display: block; }
.quota-summary { flex: 0 0 calc(50% - 8rpx); min-width: 0; padding: 22rpx 18rpx; background: #fafafa; border-radius: 16rpx; box-sizing: border-box; }
.remaining-tip { color: #555; font-size: 26rpx; text-align: center; }
.remaining-tip text { color: #222; font-size: 32rpx; font-weight: 750; }
.quota-details { margin-top: 18rpx; padding-top: 16rpx; color: #777; font-size: 22rpx; border-top: 1rpx solid #eee; }
.quota-details > view { display: flex; align-items: flex-start; justify-content: space-between; gap: 8rpx; min-height: 40rpx; }
.quota-details > view > text:last-child { text-align: right; }
.quota-expiry { color: #aaa; font-size: 19rpx; }
.query-ad-slot { width: 100%; margin-top: 24rpx; overflow: hidden; border-radius: 12rpx; }
.ranking-page { padding: 28rpx 24rpx 56rpx; }
.ranking-loading, .ranking-empty { display: flex; align-items: center; justify-content: center; min-height: 420rpx; color: #aaa; font-size: 26rpx; }
.ranking-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; padding: 24rpx 26rpx; color: #fff; background: linear-gradient(120deg,#181a20,#3b1017); border-radius: 20rpx; }
.ranking-title { font-size: 34rpx; font-weight: 800; }
.ranking-date { margin-left: 14rpx; color: rgba(255,255,255,.65); font-size: 21rpx; }
.ranking-update-hint { display: block; margin-top: 8rpx; color: rgba(255,255,255,.68); font-size: 21rpx; font-weight: 400; }
.ranking-source { color: rgba(255,255,255,.7); font-size: 20rpx; }
.ranking-columns { display: flex; align-items: flex-start; gap: 12rpx; }
.ranking-section { flex: 0 0 calc(50% - 6rpx); min-width: 0; overflow: hidden; background: #fff; border-radius: 16rpx; box-shadow: 0 7rpx 24rpx rgba(0,0,0,.04); box-sizing: border-box; }
.ranking-section-title { padding: 20rpx 14rpx; color: #222; font-size: 24rpx; font-weight: 800; border-bottom: 1rpx solid #eee; white-space: nowrap; }
.ranking-section-title.inflow::before, .ranking-section-title.outflow::before { display: inline-block; width: 7rpx; height: 28rpx; margin-right: 12rpx; content: ''; vertical-align: -4rpx; border-radius: 999rpx; }
.ranking-section-title.inflow::before { background: #ff3b30; }
.ranking-section-title.outflow::before { background: #00a84f; }
.ranking-row { display: flex; align-items: center; min-height: 104rpx; padding: 0 10rpx; border-bottom: 1rpx solid #ededed; box-sizing: border-box; }
.ranking-row:last-child { border-bottom: 0; }
.ranking-number { display: flex; flex: 0 0 32rpx; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; margin-right: 8rpx; color: #777; font-size: 18rpx; font-weight: 800; background: #f3f3f3; border-radius: 50%; }
.ranking-row:nth-child(2) .ranking-number { color: #fff; background: #ff3b30; }
.ranking-stock { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.ranking-stock text:first-child { overflow: hidden; color: #222; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.ranking-stock text:last-child { color: #aaa; font-size: 16rpx; }
.ranking-value { flex: 0 0 92rpx; overflow: hidden; font-size: 19rpx; font-weight: 750; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.ranking-value.up { color: #ff3b30; }
.ranking-value.down { color: #00a84f; }
.ranking-share { display: inline-flex; flex: none; align-items: center; gap: 3rpx; margin-left: 6rpx; padding: 7rpx 8rpx; color: #d92436; font-size: 16rpx; font-weight: 700; background: #fff2f4; border: 1rpx solid #ffc7cf; border-radius: 999rpx; }
.ranking-share-icon { width: 18rpx; height: 18rpx; background: center / 100% 100% no-repeat url("data:image/svg+xml;base64,"); }
.ranking-list-empty { padding: 46rpx 0; color: #aaa; font-size: 23rpx; text-align: center; }
.ranking-tip { padding: 10rpx 12rpx; color: #aaa; font-size: 20rpx; line-height: 1.55; text-align: center; }
.history-page { padding: 34rpx; }
.history-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 20rpx; color: #333; font-size: 28rpx; font-weight: 700; }
.history-refresh { padding: 13rpx 24rpx; color: #fff; font-size: 23rpx; font-weight: 700; background: #ff2442; border-radius: 999rpx; box-shadow: 0 6rpx 16rpx rgba(255,36,66,.22); }
.history-refresh.disabled { opacity: .62; }
.empty { padding: 160rpx 0; color: #aaa; font-size: 26rpx; text-align: center; }
.order-list { overflow: hidden; background: #fff; border-radius: 20rpx; }
.order-card { display: flex; align-items: center; justify-content: space-between; min-height: 116rpx; padding: 0 28rpx; border-bottom: 1rpx dashed #e7e7e7; }
.order-card:last-child { border-bottom: 0; }
.order-main { min-width: 0; margin-right: 16rpx; flex: 1; }
.order-stock { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.order-name { overflow: hidden; color: #222; font-size: 27rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.order-code { flex: none; color: #999; font-size: 20rpx; font-weight: 400; letter-spacing: 0; }
.order-poster-link { display: inline-flex; align-items: center; gap: 7rpx; min-height: 38rpx; margin-top: 7rpx; padding: 0 12rpx; color: #d92436; font-size: 20rpx; font-weight: 700; background: #fff2f4; border: 1rpx solid #ffc7cf; border-radius: 999rpx; }
.order-poster-icon { width: 23rpx; height: 23rpx; background: center / 100% 100% no-repeat url("data:image/svg+xml;base64,"); }
.order-meta { display: flex; align-items: center; gap: 10rpx; min-width: 0; margin-top: 8rpx; }
.order-query-time { overflow: hidden; color: #999; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.order-type { display: inline-flex; flex: none; padding: 4rpx 10rpx; color: #777; font-size: 18rpx; background: #f1f1f1; border-radius: 999rpx; }
.order-side { display: flex; align-items: center; gap: 20rpx; color: #555; font-size: 25rpx; }
.order-side.pending { color: #b07a12; }
.order-side.ready { color: #ff2442; font-weight: 700; }
.order-side.failed { color: #d93025; }
.arrow { color: #bbb; font-size: 42rpx; font-weight: 300; }
.history-pagination { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; padding: 0 20rpx; color: #666; }
.history-page-button { display: flex; align-items: center; justify-content: center; min-width: 120rpx; min-height: 68rpx; font-size: 25rpx; }
.history-page-button.disabled { color: #ccc; }
.history-page-number { color: #999; font-size: 24rpx; }
.history-ad-slot { width: 100%; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); overflow: hidden; border-radius: 12rpx; }
.topup-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1350; display: flex; align-items: flex-end; justify-content: center; background: rgba(0,0,0,.5); }
.topup-sheet { width: 100%; padding: 18rpx 34rpx calc(34rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 36rpx 36rpx 0 0; box-sizing: border-box; animation: contact-sheet-in .22s ease-out; }
.topup-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; background: #ddd; border-radius: 999rpx; }
.topup-title { color: #222; font-size: 36rpx; font-weight: 800; text-align: center; }
.topup-subtitle { margin-top: 10rpx; color: #888; font-size: 22rpx; line-height: 1.5; text-align: center; }
.topup-skus { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 30rpx; }
.topup-sku { position: relative; display: flex; flex: 0 0 calc(50% - 9rpx); min-width: 0; align-items: center; justify-content: space-between; min-height: 128rpx; padding: 20rpx 22rpx; background: #fafafa; border: 2rpx solid transparent; border-radius: 20rpx; box-sizing: border-box; }
.topup-sku.selected { background: #fff5f0; border-color: #ff6b2c; box-shadow: 0 7rpx 18rpx rgba(255,107,44,.1); }
.topup-times { display: block; color: #222; font-size: 34rpx; font-weight: 800; }
.topup-unit { display: block; margin-top: 6rpx; color: #999; font-size: 19rpx; }
.topup-price { color: #f04424; font-size: 31rpx; font-weight: 800; }
.topup-check { position: absolute; top: -2rpx; right: -2rpx; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; color: #fff; font-size: 21rpx; font-weight: 800; background: #ff6b2c; border-radius: 0 18rpx 0 16rpx; }
.topup-pay { display: flex; align-items: center; justify-content: center; height: 88rpx; margin: 30rpx 0 0; color: #fff; font-size: 28rpx; font-weight: 800; line-height: normal; background: linear-gradient(100deg,#ff7138,#f04424); border-radius: 999rpx; box-shadow: 0 10rpx 24rpx rgba(240,68,36,.2); }
.topup-pay::after { border: 0; }
.topup-pay[disabled] { color: #fff; opacity: .7; }
.topup-contact { padding: 24rpx 0 4rpx; color: #2474d2; font-size: 24rpx; text-align: center; }
.contact-qr-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1300; display: flex; align-items: flex-end; justify-content: center; background: rgba(0,0,0,.48); }
.contact-qr-sheet { width: 100%; padding: 20rpx 48rpx calc(32rpx + env(safe-area-inset-bottom)); text-align: center; background: #fff; border-radius: 36rpx 36rpx 0 0; box-sizing: border-box; animation: contact-sheet-in .22s ease-out; }
.contact-qr-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; background: #ddd; border-radius: 999rpx; }
.contact-qr-title { color: #222; font-size: 38rpx; font-weight: 750; }
.contact-qr-description { margin: 14rpx 0 24rpx; color: #999; font-size: 24rpx; line-height: 1.5; }
.contact-qr-image { display: block; width: 70vw; max-width: 560rpx; margin: 0 auto; border-radius: 18rpx; }
.contact-qr-tip { margin-top: 16rpx; color: #aaa; font-size: 21rpx; }
@keyframes contact-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
