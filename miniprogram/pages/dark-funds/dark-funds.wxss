.page { min-height: 100vh; background: #f6f6f6; }
.tabs { position: sticky; top: 0; z-index: 10; display: flex; height: 92rpx; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; color: #777; font-size: 28rpx; }
.tab.active { color: #222; font-weight: 700; }
.tab.active::after { position: absolute; bottom: 0; left: 50%; width: 52rpx; height: 6rpx; content: ''; background: #ff2442; border-radius: 999rpx; transform: translateX(-50%); }
.query-page { padding: 30rpx 24rpx; }
.query-card { padding: 48rpx 32rpx 38rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.04); }
.eyebrow { color: #ff2442; font-size: 23rpx; font-weight: 700; }
.query-title { margin-top: 12rpx; color: #222; font-size: 42rpx; font-weight: 800; }
.query-subtitle { margin-top: 14rpx; color: #999; font-size: 24rpx; }
.code-box { margin-top: 46rpx; padding: 0 24rpx; background: #f7f7f7; border: 2rpx solid transparent; border-radius: 16rpx; }
.code-input { height: 96rpx; color: #222; font-size: 34rpx; font-weight: 700; letter-spacing: 6rpx; text-align: center; }
.trade-date { margin-top: 22rpx; color: #777; font-size: 24rpx; text-align: center; }
.query-button, .pay-button { margin: 40rpx 0 0; height: 88rpx; color: #fff; font-size: 29rpx; font-weight: 700; line-height: 88rpx; background: #ff2442; border-radius: 999rpx; }
.query-button::after, .pay-button::after { border: none; }
.query-button[disabled] { color: #fff; background: #ff9aaa; }
.price-tip { margin-top: 18rpx; color: #aaa; font-size: 22rpx; text-align: center; }
.history-page { padding: 24rpx; }
.empty { padding: 160rpx 0; color: #aaa; font-size: 26rpx; text-align: center; }
.order-list { overflow: hidden; background: #fff; border-radius: 20rpx; }
.order-card { display: flex; align-items: center; justify-content: space-between; min-height: 116rpx; padding: 0 28rpx; border-bottom: 1rpx solid #eee; }
.order-card:last-child { border-bottom: 0; }
.order-main { min-width: 0; }
.order-code { color: #222; font-size: 31rpx; font-weight: 750; letter-spacing: 2rpx; }
.order-date { margin-top: 8rpx; color: #999; font-size: 22rpx; }
.order-side { display: flex; align-items: center; gap: 20rpx; color: #555; font-size: 25rpx; }
.arrow { color: #bbb; font-size: 42rpx; font-weight: 300; }
.mask { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: flex-end; background: rgba(0,0,0,.48); }
.payment-card { width: 100%; padding: 38rpx 34rpx calc(36rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 30rpx 30rpx 0 0; }
.payment-title { margin-bottom: 20rpx; color: #222; font-size: 34rpx; font-weight: 800; }
.payment-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; color: #777; font-size: 26rpx; border-bottom: 1rpx solid #f1f1f1; }
.payment-row text:last-child { color: #222; font-weight: 650; }
.payment-row.total { margin-top: 8rpx; border-bottom: 0; }
.payment-row.total text:last-child { color: #ff2442; font-size: 36rpx; font-weight: 800; }
.pay-button { margin-top: 28rpx; }
.payment-cancel { padding: 24rpx 0 6rpx; color: #999; font-size: 25rpx; text-align: center; }
