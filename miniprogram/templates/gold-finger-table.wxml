<template name="gold-finger-table">
  <view class="gold-history-table">
    <view class="history-head history-grid">
      <text class="history-date-col">日期</text><text>阳谱</text><text>阴谱</text><text class="history-finger-col">点金</text><text class="history-trend-col">趋势</text><text class="history-position-col">建议仓位</text>
    </view>
    <view wx:for="{{records}}" wx:key="date" class="history-row history-grid">
      <text class="history-date">{{item.date}}</text>
      <text class="history-yang {{item.yangClass}}">{{item.yang}}%</text>
      <text class="history-yin {{item.yinClass}}">{{item.yin}}%</text>
      <view class="history-finger-cell"><image class="history-finger" src="{{item.fingerIcon}}" mode="aspectFit" /></view>
      <view class="history-trend"><image class="history-trend-icon" src="{{item.trendIcon}}" mode="aspectFit" /></view>
      <text class="history-position">{{item.position}}%</text>
    </view>
  </view>
</template>
