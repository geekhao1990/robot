/* app.wxss 全局样式 */
page {
  --primary: #ff2442;
  --bg: #f5f5f5;
  --text: #333333;
  --text-light: #999999;
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
}

view, text, image, scroll-view {
  box-sizing: border-box;
}

.flex {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
}

.divider {
  height: 1rpx;
  background: #eee;
}

/* 全局统一的下拉刷新样式 */
.refresh-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  gap: 14rpx;
  color: #999;
  font-size: 24rpx;
  text-align: center;
}

.refresh-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  color: #888;
  font-size: 28rpx;
  line-height: 1;
  border: 2rpx solid #c8c8c8;
  border-radius: 50%;
  box-sizing: border-box;
  transform: rotate(0deg);
  transition: transform 160ms ease;
}

.refresh-arrow.is-ready {
  color: #888;
  border-color: #c8c8c8;
  transform: rotate(180deg);
}

.refresh-loading {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #dedede;
  border-top-color: #888;
  border-radius: 50%;
  box-sizing: border-box;
  animation: refresh-spin 700ms linear infinite;
}

@keyframes refresh-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 通用骨架 / 占位 */
.placeholder {
  color: var(--text-light);
  text-align: center;
  padding: 60rpx 0;
}
