<view class="tab-bar">
  <block wx:for="{{list}}" wx:key="text">
    <view
      class="tab-item {{item.ai ? 'ai-item' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view wx:if="{{item.ai}}" class="ai-btn">AI</view>
      <view wx:else class="tab-text {{selected === index ? 'active' : ''}}">
        {{item.text}}
      </view>
    </view>
  </block>
</view>
